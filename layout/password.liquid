<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ request.locale.direction | default: 'ltr' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  {% render 'meta-tags' %}
  {% render 'global-settings-css' %}
  {{ 'sp-reset.css' | asset_url | stylesheet_tag }}
  {{ 'sp-base.css' | asset_url | stylesheet_tag }}
  {{ 'sp-components.css' | asset_url | stylesheet_tag }}
  {{ 'sp-global-forms.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="sp-password-layout">
  <main id="MainContent" role="main">{{ content_for_layout }}</main>
  {% render 'global-settings-json' %}
  <div id="SpiderLiveRegion" class="visually-hidden" role="status" aria-live="polite"></div>
</body>
</html>

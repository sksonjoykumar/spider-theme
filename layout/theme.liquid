<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ request.locale.direction | default: 'ltr' }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  {% render 'meta-tags' %}
  {% render 'social-meta' %}
  {% render 'structured-data' %}
  {% if settings.sp_favicon != blank %}<link rel="icon" href="{{ settings.sp_favicon | image_url: width: 64, height: 64 }}">{% endif %}
  {% render 'global-settings-css' %}
  {{ 'sp-reset.css' | asset_url | stylesheet_tag }}
  {{ 'sp-base.css' | asset_url | stylesheet_tag }}
  {{ 'sp-components.css' | asset_url | stylesheet_tag }}
  {{ 'sp-global-forms.css' | asset_url | stylesheet_tag }}
  {{ 'sp-product-card.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
  <script>document.documentElement.classList.remove('no-js');document.documentElement.classList.add('js');</script>
</head>
<body class="{% render 'global-settings-classes' %}">
  {% if settings.a11y_skip_link %}{% render 'skip-link' %}{% endif %}
  {% sections 'header-group' %}
  <main id="MainContent" class="sp-main" tabindex="-1">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
  {% sections 'system-group' %}
  <div id="SpiderLiveRegion" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
  {% render 'global-settings-json' %}
  <script src="{{ 'sp-free-commerce.js' | asset_url }}" defer></script>
</body>
</html>

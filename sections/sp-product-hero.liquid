{% render 'sp-section-color-scheme', section: section %}
{{ 'sp-product-hero.css' | asset_url | stylesheet_tag }}
{% assign hero_product = section.settings.product %}
<section class="sp-free-product-hero" data-section-id="{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="sp-container sp-free-product-hero__inner sp-free-product-hero__inner--{{ section.settings.image_position }}">
    <div class="sp-free-product-hero__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: section.settings.image.alt | default: section.settings.heading }}
      {% elsif hero_product != blank and hero_product.featured_media %}
        {{ hero_product.featured_media.preview_image | image_url: width: 1400 | image_tag: widths: '480, 720, 960, 1200, 1400', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: hero_product.title }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag }}
      {% endif %}
    </div>
    <div class="sp-free-product-hero__content">
      {% if section.settings.eyebrow != blank %}<p class="sp-free-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h2>{{ section.settings.heading | default: hero_product.title | escape }}</h2>
      {% if section.settings.description != blank %}<div class="rte">{{ section.settings.description }}</div>{% elsif hero_product != blank %}<div class="rte">{{ hero_product.description | strip_html | truncatewords: 35 }}</div>{% endif %}
      {% if hero_product != blank %}
        <p class="sp-free-product-hero__price">{{ hero_product.price | money }}</p>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="sp-button sp-button--primary" href="{% if section.settings.button_link != blank %}{{ section.settings.button_link }}{% elsif hero_product != blank %}{{ hero_product.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">{{ section.settings.button_label | escape }}</a>
      {% endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Product hero",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "sp_color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "image_picker", "id": "image", "label": "Image override" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured product" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Meet your next favourite" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Introduce a product with a strong image and a clear message.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }] }
  ],
  "presets": [{ "name": "Product hero", "category": "Banners" }]
}
{% endschema %}

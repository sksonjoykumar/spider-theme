{% render 'sp-section-color-scheme', section: section %}
<article class="sp-section" data-section-id="{{ section.id }}"><div class="sp-container sp-container--narrow"><p><a href="{{ blog.url }}">{{ blog.title | escape }}</a></p><h1>{{ article.title | escape }}</h1><p>{{ article.published_at | time_tag: format: 'date' }}{% if article.author %} — {{ article.author | escape }}{% endif %}</p>{% if article.image %}{% render 'responsive-image', image: article.image, loading: 'eager', sizes: '100vw' %}{% endif %}<div class="rte">{{ article.content }}</div></div></article>{% schema %}
{
  "name": "Main article",
  "settings": [
    {
      "type": "header",
      "content": "Global design system"
    },
    {
      "type": "color_scheme",
      "id": "sp_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1",
      "info": "Shared Spider color panel. Edit schemes once in Theme settings → Spider Color Schemes."
    }
  ]
}
{% endschema %}
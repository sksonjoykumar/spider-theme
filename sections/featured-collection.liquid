{% render 'sp-section-color-scheme', section: section %}
{{ 'sp-featured-collection.css' | asset_url | stylesheet_tag }}
{% assign featured_collection = section.settings.collection %}
<section class="sp-free-featured-collection" data-section-id="{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="sp-container">
    <div class="sp-free-section-heading">
      {% if section.settings.eyebrow != blank %}<p class="sp-free-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <div>
        <h2>{{ section.settings.heading | escape }}</h2>
        {% if section.settings.description != blank %}<div class="rte">{{ section.settings.description }}</div>{% endif %}
      </div>
      {% if section.settings.show_view_all and featured_collection != blank %}
        <a class="sp-button sp-button--secondary" href="{{ featured_collection.url }}">{{ section.settings.view_all_label | escape }}</a>
      {% endif %}
    </div>
    {% if featured_collection != blank and featured_collection.products_count > 0 %}
      <div class="sp-free-product-grid{% if section.settings.layout == 'carousel' %} sp-free-product-grid--carousel{% endif %}" style="--sp-free-cols:{{ section.settings.columns_desktop }};--sp-free-cols-mobile:{{ section.settings.columns_mobile }};">
        {% for card_product in featured_collection.products limit: section.settings.products_to_show %}
          {% render 'product-card', card_product: card_product, sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw' %}
        {% endfor %}
      </div>
    {% elsif request.design_mode %}
      <p class="sp-free-empty">Choose a collection to display products here.</p>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "sp-section",
  "settings": [
    { "type": "color_scheme", "id": "sp_color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our selection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured products" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Explore a few of our customer favourites.</p>" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "select", "id": "layout", "label": "Layout", "default": "grid", "options": [{ "value": "grid", "label": "Grid" }, { "value": "carousel", "label": "Horizontal carousel" }] },
    { "type": "range", "id": "columns_desktop", "label": "Desktop columns", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Mobile columns", "default": "2", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }] },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view all link", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" }
  ],
  "presets": [{ "name": "Featured collection", "category": "Products" }]
}
{% endschema %}

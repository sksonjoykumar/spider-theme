    {
      "type": "text",
      "id": "heading",
      "label": "Page title",
      "default": "Collections"
    },
    {
      "type": "select",
      "id": "title_style",
      "label": "Title style",
      "default": "custom",
      "options": [
        {
          "value": "global_h1",
          "label": "Global H1"
        },
        {
          "value": "global_h2",
          "label": "Global H2"
        },
        {
          "value": "global_h3",
          "label": "Global H3"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ]
    },
    {
      "type": "range",
      "id": "custom_title_size_desktop",
      "label": "Custom title size — desktop",
      "min": 24,
      "max": 72,
      "step": 2,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.title_style == 'custom' }}"
    },
    {
      "type": "range",
      "id": "custom_title_size_mobile",
      "label": "Custom title size — mobile",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32,
      "visible_if": "{{ section.settings.title_style == 'custom' }}"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Header alignment",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_intro",
      "label": "Show intro text",
      "default": false
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Intro text"
    },
    {
      "type": "checkbox",
      "id": "show_collection_count",
      "label": "Show collection count",
      "default": false
    },
    {
      "type": "text",
      "id": "collection_count_label",

    },
    {
      "type": "select",
      "id": "card_design",
      "label": "Card design",
      "default": "premium",
      "options": [
        {
          "value": "premium",
          "label": "Premium reference card"
        },
        {
          "value": "classic",
          "label": "Classic"
        },
        {
          "value": "overlay",
          "label": "Overlay"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        },
        {
          "value": "editorial",
          "label": "Editorial"
        },
        {
          "value": "bordered",

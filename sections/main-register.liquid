{{ 'sp-customer-account.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sp-customer-account.js' | asset_url }}" defer></script>
{% render 'sp-section-color-scheme', section: section %}
<section class="sp-section sp-account-page sp-account-auth" style="--sp-account-pad-top:{{ section.settings.padding_top }}px;--sp-account-pad-bottom:{{ section.settings.padding_bottom }}px">
  <div class="sp-container{% if section.settings.container_width == 'narrow' %} sp-container--narrow{% elsif section.settings.container_width == 'wide' %} sp-container--wide{% endif %}">
    <div class="sp-account-auth__layout{% if section.settings.image != blank %} has-media sp-account-auth__layout--{{ section.settings.image_position }}{% endif %}">
      {% if section.settings.image != blank %}<div class="sp-account-auth__media">{{ section.settings.image | image_url: width: 1200 | image_tag: widths: '480,720,960,1200', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: section.settings.image.alt | default: shop.name }}</div>{% endif %}
      <div class="sp-account-auth__content"><div class="sp-account-auth__panel">
        <div class="sp-account-auth__heading"><span class="sp-account-kicker">{{ 'customer.spider.join_us' | t }}</span><h1 class="sp-heading sp-heading--h2">{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ 'customer.register.title' | t }}{% endif %}</h1><p>{% if section.settings.supporting_text != blank %}{{ section.settings.supporting_text | escape }}{% else %}{{ 'customer.spider.register_intro' | t }}{% endif %}</p></div>
        {% form 'create_customer' %}
          {% if form.errors %}<div class="sp-account-alert sp-account-alert--error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
          <div class="sp-account-form-grid">
            {% render 'sp-account-form-field', id: 'RegisterFirst', name: 'customer[first_name]', label: 'customer.register.first_name', value: form.first_name, autocomplete: 'given-name' %}
            {% render 'sp-account-form-field', id: 'RegisterLast', name: 'customer[last_name]', label: 'customer.register.last_name', value: form.last_name, autocomplete: 'family-name' %}
          </div>
          {% render 'sp-account-form-field', id: 'RegisterEmail', name: 'customer[email]', type: 'email', label: 'customer.register.email', value: form.email, autocomplete: 'email', required: true %}
          {% render 'sp-account-form-field', id: 'RegisterPassword', name: 'customer[password]', type: 'password', label: 'customer.register.password', autocomplete: 'new-password', required: true %}
          <p class="sp-account-help">{{ 'customer.spider.password_guidance' | t }}</p>
          <button class="sp-button sp-button--primary sp-account-auth__submit" type="submit">{{ 'customer.register.submit' | t }}</button>
        {% endform %}
        <div class="sp-account-auth__secondary"><span>{{ 'customer.spider.already_have_account' | t }}</span><a class="sp-button sp-button--outline" href="{{ routes.account_login_url }}">{{ 'customer.login_page.sign_in' | t }}</a></div>
        <a class="sp-account-text-link" href="{{ routes.root_url }}">{{ 'customer.spider.return_to_store' | t }}</a>
      </div></div>
    </div>
  </div>
</section>
{% schema %}
{
  "name":"Main register",
  "settings":[
    {"type":"color_scheme","id":"sp_color_scheme","label":"Color scheme","default":"scheme-1"},
    {"type":"select","id":"container_width","label":"Container width","default":"narrow","options":[{"value":"narrow","label":"Narrow"},{"value":"default","label":"Theme default"},{"value":"wide","label":"Wide"}]},
    {"type":"text","id":"heading","label":"Heading","default":"Create your account"},
    {"type":"textarea","id":"supporting_text","label":"Supporting text","default":"Create an account for faster checkout, order history and saved addresses."},
    {"type":"image_picker","id":"image","label":"Optional image"},
    {"type":"select","id":"image_position","label":"Desktop image position","default":"left","options":[{"value":"left","label":"Left"},{"value":"right","label":"Right"}]},
    {"type":"range","id":"padding_top","label":"Padding top","min":24,"max":160,"step":8,"unit":"px","default":72},
    {"type":"range","id":"padding_bottom","label":"Padding bottom","min":24,"max":160,"step":8,"unit":"px","default":72}
  ]
}
{% endschema %}

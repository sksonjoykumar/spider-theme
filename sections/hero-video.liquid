{{ 'sp-hero-video.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sp-hero-video.js' | asset_url }}" defer></script>

{% liquid
  assign lifestyle_hero = false
  if section.settings.layout_style == 'lifestyle'
    assign lifestyle_hero = true
  endif
  assign source = section.settings.video_source
  assign external_type = ''
  assign external_id = ''
  if source == 'external' and section.settings.external_video != blank
    assign external_type = section.settings.external_video.type
    assign external_id = section.settings.external_video.id
  endif

  assign has_shopify_video = false
  if source == 'shopify' and section.settings.shopify_video != blank
    assign has_shopify_video = true
  endif
  assign has_external_video = false
  if source == 'external' and external_id != blank
    assign has_external_video = true
  endif
  assign has_video = false
  if has_shopify_video or has_external_video
    assign has_video = true
  endif

  assign effective_muted = section.settings.muted
  if section.settings.autoplay and lifestyle_hero == false
    assign effective_muted = true
  endif
  assign effective_controls = section.settings.show_controls
  if section.settings.video_purpose == 'meaningful' or lifestyle_hero
    assign effective_controls = true
  endif

  assign effective_purpose = section.settings.video_purpose
  if lifestyle_hero
    assign effective_purpose = 'meaningful'
  endif

  assign poster = section.settings.poster_image
  if poster == blank and section.settings.shopify_video != blank
    assign poster = section.settings.shopify_video.preview_image
  endif

  assign poster_mobile = section.settings.poster_image_mobile
  if poster_mobile == blank
    assign poster_mobile = poster
  endif

  assign mobile_ratio = section.settings.mobile_video_ratio
  if mobile_ratio == 'same'
    assign mobile_ratio = section.settings.video_ratio
  endif

  assign is_priority = false
  if section.location == 'template' and section.index == 1
    assign is_priority = true
  endif

  assign native_preload = 'none'
  assign native_loading = 'lazy'
  if is_priority and section.settings.autoplay and lifestyle_hero == false
    assign native_preload = 'metadata'
    assign native_loading = 'eager'
  endif

  assign radius_desktop = section.settings.hero_radius_desktop
  assign radius_tablet = section.settings.hero_radius_tablet
  assign radius_mobile = section.settings.hero_radius_mobile
  if section.settings.container == 'full_width' and section.settings.radius_full_width == false
    assign radius_desktop = 0
    assign radius_tablet = 0
    assign radius_mobile = 0
  endif

  assign resolved_animation = section.settings.animation
  if resolved_animation == 'inherit'
    assign resolved_animation = 'none'
  endif

  assign show_play_control = false
  if has_video
    if section.settings.show_playback_control
      assign show_play_control = true
    elsif lifestyle_hero and section.settings.center_play_enabled
      assign show_play_control = true
    endif
  endif

  assign full_screen_header_offset = 0
  assign full_screen_announcement_offset = 0
  if section.settings.subtract_header
    assign full_screen_header_offset = 1
  endif
  if section.settings.subtract_announcement
    assign full_screen_announcement_offset = 1
  endif
%}

<sp-hero-video
  id="SpHeroVideo-{{ section.id }}"
  class="sp-hero-video sp-hero-video--{{ section.settings.container }}{% if section.settings.custom_class != blank %} sp-custom-{{ section.settings.custom_class | handleize }}{% endif %}"
  data-section-id="{{ section.id }}"
  data-layout-style="{{ section.settings.layout_style }}"
  data-click-to-play="{{ lifestyle_hero }}"
  data-global-colors="{{ section.settings.use_global_colors }}"
  data-center-play="{{ section.settings.center_play_enabled }}"
  data-video-source="{{ source }}"
  data-video-type="{{ external_type }}"
  data-video-id="{{ external_id | escape }}"
  data-has-video="{{ has_video }}"
  data-autoplay="{{ section.settings.autoplay }}"
  data-muted="{{ effective_muted }}"
  data-loop="{{ section.settings.loop }}"
  data-controls="{{ effective_controls }}"
  data-video-purpose="{{ effective_purpose }}"
  data-video-title="{{ section.settings.video_title | escape }}"
  data-play-mobile="{{ section.settings.play_on_mobile }}"
  data-video-fit="{{ section.settings.video_fit }}"
  data-video-position="{{ section.settings.video_position }}"
  data-video-position-mobile="{{ section.settings.video_position_mobile }}"
  data-mobile-content="{{ section.settings.mobile_content_style }}"
  data-position-type="{{ section.settings.position_type }}"
  data-animation="{{ resolved_animation }}"
  data-animation-duration="{{ section.settings.animation_duration }}"
  data-animation-delay="{{ section.settings.animation_delay }}"
  data-design-mode="{{ request.design_mode }}"
  style="
    --sp-hv-section-bg: {{ section.settings.section_background }};
    --sp-hv-ratio-d: {{ section.settings.video_ratio }};
    --sp-hv-ratio-m: {{ mobile_ratio }};
    --sp-hv-custom-height-d: {{ section.settings.custom_height_desktop }}px;
    --sp-hv-custom-height-t: {{ section.settings.custom_height_tablet }}px;
    --sp-hv-custom-height-m: {{ section.settings.custom_height_mobile }}px;
    --sp-hv-header-offset: {% if full_screen_header_offset == 1 %}var(--sp-header-height, 0px){% else %}0px{% endif %};
    --sp-hv-announcement-offset: {% if full_screen_announcement_offset == 1 %}var(--sp-announcement-bar-height, 0px){% else %}0px{% endif %};
    --sp-hv-radius-d: {{ radius_desktop }}px;
    --sp-hv-radius-t: {{ radius_tablet }}px;
    --sp-hv-radius-m: {{ radius_mobile }}px;
    --sp-hv-border-width: {% if section.settings.show_border %}{{ section.settings.border_width }}px{% else %}0px{% endif %};
    --sp-hv-border-color: {{ section.settings.border_color }};
    --sp-hv-overlay-color: {{ section.settings.overlay_color }};
    --sp-hv-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --sp-hv-overlay-color-m: {% if section.settings.same_overlay_mobile %}{{ section.settings.overlay_color }}{% else %}{{ section.settings.overlay_color_mobile }}{% endif %};
    --sp-hv-overlay-opacity-m: {% if section.settings.same_overlay_mobile %}{{ section.settings.overlay_opacity | divided_by: 100.0 }}{% else %}{{ section.settings.overlay_opacity_mobile | divided_by: 100.0 }}{% endif %};
    --sp-hv-content-x: {{ section.settings.content_x }};
    --sp-hv-content-y: {{ section.settings.content_y }};
    --sp-hv-content-x-m: {{ section.settings.content_x_mobile }};
    --sp-hv-content-y-m: {{ section.settings.content_y_mobile }};
    --sp-hv-content-width-d: {{ section.settings.content_width_desktop }}px;
    --sp-hv-content-width-t: {{ section.settings.content_width_tablet }}px;
    --sp-hv-content-width-m: {{ section.settings.content_width_mobile }}px;
    --sp-hv-heading-color: {{ section.settings.heading_color }};
    --sp-hv-text-color: {{ section.settings.text_color }};
    --sp-hv-subtitle-color: {{ section.settings.subtitle_color }};
    --sp-hv-mobile-bg: {{ section.settings.mobile_content_background }};
    --sp-hv-mobile-heading: {{ section.settings.mobile_heading_color }};
    --sp-hv-mobile-text: {{ section.settings.mobile_text_color }};
    --sp-hv-mobile-below-py: {{ section.settings.mobile_below_padding_y }}px;
    --sp-hv-mobile-below-px: {{ section.settings.mobile_below_padding_x }}px;
    --sp-hv-mobile-below-radius: {{ section.settings.mobile_below_radius }}px;
    --sp-hv-card-bg: {{ section.settings.content_background }};
    --sp-hv-card-bg-opacity: {{ section.settings.content_background_opacity | divided_by: 100.0 }};
    --sp-hv-card-border-width: {% if section.settings.content_background_enabled and section.settings.content_border %}{{ section.settings.content_border_width }}px{% else %}0px{% endif %};
    --sp-hv-card-border-color: {{ section.settings.content_border_color }};
    --sp-hv-card-radius-d: {{ section.settings.content_radius_desktop }}px;
    --sp-hv-card-radius-t: {{ section.settings.content_radius_tablet }}px;
    --sp-hv-card-radius-m: {{ section.settings.content_radius_mobile }}px;
    --sp-hv-card-px-d: {{ section.settings.content_padding_x_desktop }}px;
    --sp-hv-card-py-d: {{ section.settings.content_padding_y_desktop }}px;
    --sp-hv-card-px-t: {{ section.settings.content_padding_x_tablet }}px;
    --sp-hv-card-py-t: {{ section.settings.content_padding_y_tablet }}px;
    --sp-hv-card-px-m: {{ section.settings.content_padding_x_mobile }}px;
    --sp-hv-card-py-m: {{ section.settings.content_padding_y_mobile }}px;
    --sp-hv-subtitle-gap: {{ section.settings.subtitle_gap }}px;
    --sp-hv-heading-gap: {{ section.settings.heading_gap }}px;
    --sp-hv-text-gap: {{ section.settings.text_gap }}px;
    --sp-hv-buttons-top-gap: {{ section.settings.buttons_top_gap }}px;
    --sp-hv-heading-weight: {{ section.settings.heading_weight }};
    --sp-hv-heading-line: {{ section.settings.heading_line_height | divided_by: 100.0 }};
    --sp-hv-heading-letter: {{ section.settings.heading_letter_spacing }}px;
    --sp-hv-subtitle-size-d: {{ section.settings.subtitle_size_desktop }}px;
    --sp-hv-subtitle-size-m: {{ section.settings.subtitle_size_mobile }}px;
    --sp-hv-heading-size-d: {{ section.settings.heading_size_desktop }}px;
    --sp-hv-heading-size-m: {{ section.settings.heading_size_mobile }}px;
    --sp-hv-text-size-d: {{ section.settings.text_size_desktop_custom }}px;
    --sp-hv-text-size-m: {{ section.settings.text_size_mobile_custom }}px;
    --sp-hv-button-gap-d: {{ section.settings.button_gap_desktop }}px;
    --sp-hv-button-gap-m: {{ section.settings.button_gap_mobile }}px;
    --sp-hv-button-1-radius: {{ section.settings.button_1_radius }}px;
    --sp-hv-button-2-radius: {{ section.settings.button_2_radius }}px;
    --sp-hv-button-1-bg: {{ section.settings.button_1_bg }};
    --sp-hv-button-1-text: {{ section.settings.button_1_text }};
    --sp-hv-button-1-border: {{ section.settings.button_1_border }};
    --sp-hv-button-1-hover-bg: {{ section.settings.button_1_hover_bg }};
    --sp-hv-button-1-hover-text: {{ section.settings.button_1_hover_text }};
    --sp-hv-button-2-bg: {{ section.settings.button_2_bg }};
    --sp-hv-button-2-text: {{ section.settings.button_2_text }};
    --sp-hv-button-2-border: {{ section.settings.button_2_border }};
    --sp-hv-button-2-hover-bg: {{ section.settings.button_2_hover_bg }};
    --sp-hv-button-2-hover-text: {{ section.settings.button_2_hover_text }};
    --sp-hv-animation-duration: {{ section.settings.animation_duration }}ms;
    --sp-hv-animation-delay: {{ section.settings.animation_delay }}ms;
    --sp-hv-life-content-x: {{ section.settings.lifestyle_content_x }}%;
    --sp-hv-life-content-y: {{ section.settings.lifestyle_content_y }}%;
    --sp-hv-life-content-width: {{ section.settings.lifestyle_content_width }}px;
    --sp-hv-life-play-size: {{ section.settings.center_play_size_desktop }}px;
    --sp-hv-life-play-size-m: {{ section.settings.center_play_size_mobile }}px;
    --sp-hv-life-play-x: {{ section.settings.center_play_position_x }}%;
    --sp-hv-life-play-y: {{ section.settings.center_play_position_y }}%;
    --sp-hv-life-play-bg: {% if section.settings.center_play_use_global_colors %}var(--sp-section-surface, var(--sp-color-background, #fff)){% else %}{{ section.settings.center_play_bg }}{% endif %};
    --sp-hv-life-play-ink: {% if section.settings.center_play_use_global_colors %}var(--sp-section-heading, var(--sp-color-heading, #171717)){% else %}{{ section.settings.center_play_icon }}{% endif %};
  "
>
  <div class="sp-hero-video__shell sp-hero-video__shadow--{{ section.settings.hero_shadow }}">
    <div class="sp-hero-video__stage sp-hero-video__height--{{ section.settings.hero_height }}">
      <div class="sp-hero-video__frame sp-hero-video__fit--{{ section.settings.video_fit }}" data-sp-hv-frame>
        {% render 'sp-hero-video-media', section: section, source: source, external_type: external_type, external_id: external_id, has_shopify_video: has_shopify_video, has_external_video: has_external_video, has_video: has_video, poster: poster, poster_mobile: poster_mobile, is_priority: is_priority, effective_muted: effective_muted, effective_controls: effective_controls, native_preload: native_preload, native_loading: native_loading %}

        {% if section.settings.show_overlay %}
          <span class="sp-hero-video__overlay sp-hero-video__overlay--{{ section.settings.overlay_style }} sp-hero-video__overlay--{{ section.settings.gradient_direction }}" aria-hidden="true"></span>
        {% endif %}

        {% if show_play_control %}
          <button class="sp-hero-video__playback{% if lifestyle_hero and section.settings.center_play_enabled %} sp-hero-video__playback--lifestyle{% endif %}" type="button" data-sp-hv-playback aria-label="Play video" aria-pressed="false">
            <svg class="sp-hero-video__playback-icon sp-hero-video__playback-icon--play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            <svg class="sp-hero-video__playback-icon sp-hero-video__playback-icon--pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 5h4v14H6zm8 0h4v14h-4z"/></svg>
          </button>
        {% endif %}
        {% if lifestyle_hero and has_video %}
          <span class="sp-hero-video__video-status" data-sp-hv-video-status role="status" aria-live="polite"></span>
        {% endif %}
      </div>

      <div class="sp-hero-video__content-layer{% if section.settings.content_in_container %} sp-hero-video__content-layer--container{% endif %}" data-sp-hv-content-layer>
        {% render 'sp-hero-video-content', section: section %}
      </div>
    </div>
  </div>
</sp-hero-video>

{% schema %}
{
  "name": "Video hero",
  "tag": "section",
  "class": "sp-hero-video-section",
 "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.system"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "GENERAL"
    },
    {
      "type": "header",
      "content": "PREMIUM LIFESTYLE VIDEO"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Video presentation",
      "options": [
        {
          "value": "original",
          "label": "Original background hero"
        },
        {
          "value": "lifestyle",
          "label": "Premium lifestyle — reference"
        },
        {
          "value": "centered",
          "label": "Centered video hero"
        },
        {
          "value": "minimal",
          "label": "Minimal video hero"
        }
      ],
      "default": "original",
      "info": "Use Lifestyle for the reference layout; existing instances stay Original."
    },
    {
      "type": "checkbox",
      "id": "use_global_colors",
      "label": "Use Spider global heading/text colors",
      "default": false,
      "info": "Enable for lifestyle with a light poster. Off retains previous custom colors."
    },
    {
      "type": "range",
      "id": "lifestyle_content_x",
      "label": "Lifestyle content left position",
      "min": 2,
      "max": 22,
      "step": 1,
      "unit": "%",
      "default": 8
    },
    {
      "type": "range",
      "id": "lifestyle_content_y",
      "label": "Lifestyle content vertical position",
      "min": 30,
      "max": 70,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "lifestyle_content_width",
      "label": "Lifestyle content max width",
      "min": 420,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 680
    },
    {
      "type": "checkbox",
      "id": "button_show_arrows",
      "label": "Show arrow icons on CTAs",
      "default": false
    },
    {
      "type": "select",
      "id": "button_2_action",
      "label": "Second button action",
      "options": [
        {
          "value": "link",
          "label": "Open URL"
        },
        {
          "value": "play_video",
          "label": "Play hero video"
        }
      ],
      "default": "link"
    },
    {
      "type": "header",
      "content": "CENTER PLAY BUTTON"
    },
    {
      "type": "checkbox",
      "id": "center_play_enabled",
      "label": "Show center Play button on lifestyle hero",
      "default": true
    },
    {
      "type": "range",
      "id": "center_play_size_desktop",
      "label": "Play button desktop diameter",
      "min": 64,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 104
    },
    {
      "type": "range",
      "id": "center_play_size_mobile",
      "label": "Play button mobile diameter",
      "min": 48,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 68
    },
    {
      "type": "range",
      "id": "center_play_position_x",
      "label": "Play horizontal position",
      "min": 10,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 50
    },
    {
      "type": "range",
      "id": "center_play_position_y",
      "label": "Play vertical position",
      "min": 10,
      "max": 90,
      "step": 1,
      "unit": "%",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "center_play_use_global_colors",
      "label": "Use Spider global Play button colors",
      "default": true
    },
    {
      "type": "color",
      "id": "center_play_bg",
      "label": "Custom Play background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "center_play_icon",
      "label": "Custom Play icon",
      "default": "#171717"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "contained",
          "label": "Contained"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full_width",
          "label": "Full width"
        }
      ],
      "default": "full_width"
    },
    {
      "type": "checkbox",
      "id": "content_in_container",
      "label": "Content in Spider container",
      "default": true
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class suffix",
      "info": "Output is sanitized to a single sp-custom-* class."
    },
    {
      "type": "color",
      "id": "section_background",
      "label": "Section background",
      "default": "#111111"
    },
    {
      "type": "header",
      "content": "VIDEO"
    },
    {
      "type": "select",
      "id": "video_source",
      "label": "Video source",
      "options": [
        {
          "value": "shopify",
          "label": "Shopify hosted"
        },
        {
          "value": "external",
          "label": "YouTube / Vimeo"
        }
      ],
      "default": "shopify"
    },
    {
      "type": "video",
      "id": "shopify_video",
      "label": "Shopify hosted video",
      "visible_if": "{{ section.settings.video_source == 'shopify' }}"
    },
    {
      "type": "video_url",
      "id": "external_video",
      "label": "YouTube or Vimeo URL",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "visible_if": "{{ section.settings.video_source == 'external' }}"
    },
    {
      "type": "image_picker",
      "id": "poster_image",
      "label": "Desktop poster image"
    },
    {
      "type": "image_picker",
      "id": "poster_image_mobile",
      "label": "Mobile poster image"
    },
    {
      "type": "select",
      "id": "video_purpose",
      "label": "Video purpose",
      "options": [
        {
          "value": "decorative",
          "label": "Decorative background"
        },
        {
          "value": "meaningful",
          "label": "Meaningful content"
        }
      ],
      "default": "decorative"
    },
    {
      "type": "text",
      "id": "video_title",
      "label": "Accessible video title",
      "default": "Hero video",
      "visible_if": "{{ section.settings.video_purpose == 'meaningful' }}"
    },
    {
      "type": "header",
      "content": "VIDEO BEHAVIOUR"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "muted",
      "label": "Mute video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_controls",
      "label": "Show native/player controls",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_playback_control",
      "label": "Show pause / play control",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "play_on_mobile",
      "label": "Play background video on mobile",
      "default": true
    },
    {
      "type": "select",
      "id": "video_fit",
      "label": "Video fit",
      "options": [
        {
          "value": "cover",
          "label": "Cover"
        },
        {
          "value": "contain",
          "label": "Contain"
        }
      ],
      "default": "cover"
    },
    {
      "type": "select",
      "id": "video_position",
      "label": "Desktop video position",
      "options": [
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "top-center",
          "label": "Top center"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "middle-left",
          "label": "Middle left"
        },
        {
          "value": "middle-center",
          "label": "Middle center"
        },
        {
          "value": "middle-right",
          "label": "Middle right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-center",
          "label": "Bottom center"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        }
      ],
      "default": "middle-center"
    },
    {
      "type": "select",
      "id": "video_position_mobile",
      "label": "Mobile video position",
      "options": [
        {
          "value": "top-left",
          "label": "Top left"
        },
        {
          "value": "top-center",
          "label": "Top center"
        },
        {
          "value": "top-right",
          "label": "Top right"
        },
        {
          "value": "middle-left",
          "label": "Middle left"
        },
        {
          "value": "middle-center",
          "label": "Middle center"
        },
        {
          "value": "middle-right",
          "label": "Middle right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-center",
          "label": "Bottom center"
        },
        {
          "value": "bottom-right",
          "label": "Bottom right"
        }
      ],
      "default": "middle-center"
    },

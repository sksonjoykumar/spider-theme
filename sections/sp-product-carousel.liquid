{% render 'sp-section-color-scheme', section: section %}
{{ 'sp-product-carousel.css' | asset_url | stylesheet_tag }}
<section class="sp-free-product-carousel" data-section-id="{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="sp-container">
    <div class="sp-free-section-heading">
      <div>{% if section.settings.eyebrow != blank %}<p class="sp-free-eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}<h2>{{ section.settings.heading | escape }}</h2>{% if section.settings.description != blank %}<div class="rte">{{ section.settings.description }}</div>{% endif %}</div>
      {% if section.settings.collection != blank and section.settings.show_view_all %}<a class="sp-button sp-button--secondary" href="{{ section.settings.collection.url }}">{{ section.settings.view_all_label | escape }}</a>{% endif %}
    </div>
    {% assign carousel_products = section.settings.products %}
    {% if section.settings.collection != blank %}{% assign carousel_products = section.settings.collection.products %}{% endif %}
    {% if carousel_products != blank %}
      <div class="sp-free-product-grid sp-free-product-grid--carousel" style="--sp-free-cols:{{ section.settings.columns_desktop }};--sp-free-cols-mobile:{{ section.settings.columns_mobile }};">
        {% for card_product in carousel_products limit: section.settings.products_to_show %}
          {% render 'product-card', card_product: card_product %}
        {% endfor %}
      </div>
    {% elsif request.design_mode %}
      <p class="sp-free-empty">Choose a collection or select products to display.</p>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Product carousel",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "sp_color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Popular products" },
    { "type": "richtext", "id": "description", "label": "Description" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "product_list", "id": "products", "label": "Manual products", "limit": 16 },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "columns_desktop", "label": "Card width / desktop columns", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Mobile columns", "default": "2", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }] },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view all", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" }
  ],
  "presets": [{ "name": "Product carousel", "category": "Products" }]
}
{% endschema %}

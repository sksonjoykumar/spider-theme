{{ 'sp-main-password.css' | asset_url | stylesheet_tag }}
{% render 'sp-section-color-scheme', section: section %}
{%- liquid
  assign pw_logo = settings.sp_logo
  if section.settings.use_alternate_logo and section.settings.password_logo != blank
    assign pw_logo = section.settings.password_logo
  endif
  assign pw_email_id = 'SpPwEmail-' | append: section.id
  assign pw_password_id = 'SpPwPassword-' | append: section.id
  assign pw_newsletter_errors = 'SpPwNewsletterErrors-' | append: section.id
  assign pw_access_errors = 'SpPwAccessErrors-' | append: section.id
  assign show_bottom = section.settings.show_features
  assign count_benefits = 0
  assign count_features = 0
  for block in section.blocks
    if block.type == 'benefit'
      assign count_benefits = count_benefits | plus: 1
    elsif block.type == 'feature'
      assign count_features = count_features | plus: 1
    endif
  endfor
-%}
<section
  class="sp-pw{% unless section.settings.show_benefit_dividers %} sp-pw--no-benefit-divider{% endunless %}{% unless section.settings.show_feature_dividers %} sp-pw--no-feature-divider{% endunless %}{% if section.settings.full_height %} sp-pw--full{% endif %} sp-pw--align-{{ section.settings.content_alignment }}"
  data-main-password
  data-section-id="{{ section.id }}"
  style="
    --pw-container: {{ section.settings.content_width }}px;
    --pw-wide: {{ section.settings.max_container }}px;
    --pw-logo-width: {{ section.settings.logo_width_desktop }}px;
    --pw-logo-mobile: {{ section.settings.logo_width_mobile }}px;
    --pw-heading-size: {{ section.settings.heading_size }}px;
    --pw-heading-mobile: {{ section.settings.heading_size_mobile }}px;
    --pw-body-size: {{ section.settings.body_size }}px;
    --pw-body-mobile: {{ section.settings.body_size_mobile }}px;
    --pw-stage-min: {{ section.settings.stage_height }}px;
    --pw-top: {% if section.settings.spacing_source == 'custom' %}{{ section.settings.padding_top }}px{% else %}20px{% endif %};
    --pw-bottom: {% if section.settings.spacing_source == 'custom' %}{{ section.settings.padding_bottom }}px{% else %}38px{% endif %};
    --pw-mobile-top: {% if section.settings.spacing_source == 'custom' %}{{ section.settings.padding_top_mobile }}px{% else %}32px{% endif %};
    --pw-mobile-bottom: {% if section.settings.spacing_source == 'custom' %}{{ section.settings.padding_bottom_mobile }}px{% else %}48px{% endif %};
    --pw-gap: {{ section.settings.component_gap }}px;
    --pw-accent: {% if section.settings.accent_source == 'custom' %}{{ section.settings.accent_color }}{% else %}var(--sp-color-accent, #415dff){% endif %};
    --pw-surface: {{ section.settings.stage_background }};
    --pw-overlay: {{ section.settings.overlay_opacity | times: 0.01 }};
    --pw-position: {{ section.settings.background_position }};
    --pw-count-bg: {{ section.settings.countdown_card_color }};
    --pw-footer-bg: {{ section.settings.feature_background }};
    --pw-icon-bg: {{ section.settings.icon_background }};
    --pw-icon-size: {{ section.settings.icon_size }}px;
    --pw-count-gap: {{ section.settings.countdown_gap }}px;
    --pw-card-radius: {% if section.settings.radius_source == 'custom' %}{{ section.settings.card_radius }}px{% else %}var(--sp-radius-lg, 16px){% endif %};
  "
>
  <div class="sp-pw__stage">
    <div class="sp-pw__art" aria-hidden="true">
      {% comment %}
        Backgrounds are completely optional. Render no image element until at least
        one Shopify image picker has an image; the stage's fallback color remains
        visible otherwise. A mobile-only upload is valid too.
      {% endcomment %}
      {% if section.settings.background_image != blank or section.settings.mobile_background_image != blank %}
        <picture>
          {% if section.settings.mobile_background_image != blank %}
            <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_background_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_background_image | image_url: width: 1100 }} 1100w" sizes="100vw">
          {% endif %}
          {% if section.settings.background_image != blank %}
            {{ section.settings.background_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1600, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'sp-pw__art-image', alt: '' }}
          {% else %}
            {{ section.settings.mobile_background_image | image_url: width: 1600 | image_tag: widths: '750, 1100, 1600', sizes: '100vw', loading: 'eager', fetchpriority: 'high', class: 'sp-pw__art-image', alt: '' }}
          {% endif %}
        </picture>
      {% endif %}
      <span class="sp-pw__art-overlay"></span>
    </div>
    {% if section.settings.show_blue_accent %}<div class="sp-pw__accent-arc" aria-hidden="true"></div>{% endif %}
    <div class="sp-pw__hero">
      <header class="sp-pw__brand">
        {% if pw_logo != blank %}
          <span class="sp-pw__brand-image">{{ pw_logo | image_url: width: 600 | image_tag: widths: '120, 200, 320, 480, 600', sizes: '(max-width: 749px) 130px, 160px', loading: 'eager', alt: shop.name }}</span>
        {% elsif section.settings.show_reference_logo %}
        {% else %}
          <span class="sp-pw__brand-name">{{ shop.name | escape }}</span>
        {% endif %}
      </header>
      {% if section.settings.eyebrow != blank %}<p class="sp-pw__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      <h1 class="sp-pw__title">{{ section.settings.heading | escape }}</h1>
      {% if section.settings.subheading != blank %}<div class="sp-pw__subtitle rte">{{ section.settings.subheading }}</div>{% endif %}

      {% if section.settings.show_countdown %}
        <div class="sp-pw__countdown" data-pw-countdown data-launch="{{ section.settings.launch_iso | escape }}" data-timezone="{{ section.settings.launch_timezone | escape }}">
          <p class="sp-pw__countdown-heading"><span>{{ section.settings.countdown_heading | escape }}</span></p>
          <div class="sp-pw__count-grid" role="timer" aria-label="Time remaining until launch">
            <div class="sp-pw__count-card"><strong data-pw-count="days">--</strong><small>{{ section.settings.days_label | escape }}</small></div>
            <div class="sp-pw__count-card"><strong data-pw-count="hours">--</strong><small>{{ section.settings.hours_label | escape }}</small></div>
            <div class="sp-pw__count-card"><strong data-pw-count="minutes">--</strong><small>{{ section.settings.minutes_label | escape }}</small></div>
            <div class="sp-pw__count-card"><strong data-pw-count="seconds">--</strong><small>{{ section.settings.seconds_label | escape }}</small></div>
          </div>
          <p class="sp-pw__countdown-finished" data-pw-countdown-finished role="status" hidden>{{ section.settings.countdown_expired | escape }}</p>
        </div>
      {% endif %}

      {% if count_benefits > 0 and section.settings.show_benefits %}
        <div class="sp-pw__benefits" aria-label="Launch benefits">
          {% for block in section.blocks %}
            {% if block.type == 'benefit' %}
              <div class="sp-pw__benefit{% unless block.settings.show_on_desktop %} sp-pw__hide-desktop{% endunless %}{% unless block.settings.show_on_mobile %} sp-pw__hide-mobile{% endunless %}" {{ block.shopify_attributes }}>
                <div class="sp-pw__icon-bubble">
                  {% if block.settings.icon_image != blank %}
                    {{ block.settings.icon_image | image_url: width: 100 | image_tag: width: 26, height: 26, alt: '', loading: 'lazy' }}
                  {% else %}{% render 'sp-password-icon', name: block.settings.icon %}{% endif %}
                </div>
                <div class="sp-pw__benefit-copy"><strong>{{ block.settings.title | escape }}</strong><p>{{ block.settings.description | escape }}</p></div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.show_launch_date %}
        <p class="sp-pw__launch-line">
          {% render 'sp-password-icon', name: 'calendar' %}
          <span>{{ section.settings.launch_date_label | escape }} <strong data-pw-launch-date data-override="{{ section.settings.launch_date_text | escape }}" data-launch="{{ section.settings.launch_iso | escape }}" data-timezone="{{ section.settings.launch_timezone | escape }}">{{ section.settings.launch_date_text | default: 'To be announced' | escape }}</strong></span>
        </p>
      {% endif %}
      {% if section.settings.show_password_message and shop.password_message != blank %}<div class="sp-pw__shop-message rte">{{ shop.password_message }}</div>{% endif %}

      {% if section.settings.show_newsletter %}
        <div class="sp-pw__newsletter">
          {% if section.settings.newsletter_heading != blank %}<h2 class="sp-pw__aux-heading">{{ section.settings.newsletter_heading | escape }}</h2>{% endif %}
          {% form 'customer', class: 'sp-pw__form sp-pw__newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="prospect, password page">
            <div class="sp-pw__input-shell">
              <span class="sp-pw__field-icon">{% render 'sp-password-icon', name: 'mail' %}</span>
              <label class="visually-hidden" for="{{ pw_email_id }}">{{ section.settings.email_label | escape }}</label>
              <input type="email" id="{{ pw_email_id }}" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" placeholder="{{ section.settings.email_placeholder | escape }}" {% if form.email %}value="{{ form.email | escape }}"{% elsif customer %}value="{{ customer.email | escape }}"{% endif %} required {% if form.errors %}aria-invalid="true" aria-describedby="{{ pw_newsletter_errors }}"{% endif %}>
            </div>
            <button type="submit" class="sp-button sp-button--accent sp-pw__submit sp-pw__notify"><span>{{ section.settings.newsletter_button_label | escape }}</span>{% render 'sp-password-icon', name: 'arrow-right' %}</button>
            {% if form.errors %}<div id="{{ pw_newsletter_errors }}" class="sp-pw__feedback sp-pw__feedback--error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
            {% if form.posted_successfully? %}<p class="sp-pw__feedback sp-pw__feedback--success" role="status">{{ section.settings.newsletter_success | escape }}</p>{% endif %}
          {% endform %}
          {% if section.settings.newsletter_text != blank %}<p class="sp-pw__newsletter-note">{{ section.settings.newsletter_text | escape }}</p>{% endif %}
        </div>
      {% endif %}

      {% if section.settings.show_password_form %}
        {% if section.settings.show_newsletter and section.settings.show_or %}<div class="sp-pw__or"><span>{{ section.settings.or_text | escape }}</span></div>{% endif %}
        <div class="sp-pw__access">
          {% if section.settings.access_heading != blank %}<h2 class="sp-pw__aux-heading">{{ section.settings.access_heading | escape }}</h2>{% endif %}
          {% form 'storefront_password', class: 'sp-pw__form sp-pw__password-form' %}
            {% if form.errors %}<div class="sp-pw__feedback sp-pw__feedback--error" id="{{ pw_access_errors }}" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
            <div class="sp-pw__input-shell sp-pw__password-shell">
              <span class="sp-pw__field-icon">{% render 'sp-password-icon', name: 'lock' %}</span>
              <label class="visually-hidden" for="{{ pw_password_id }}">{{ section.settings.password_label | escape }}</label>
              <input id="{{ pw_password_id }}" type="password" name="password" autocomplete="current-password" placeholder="{{ section.settings.password_placeholder | escape }}" required data-password-input {% if form.errors %}aria-invalid="true" aria-describedby="{{ pw_access_errors }}"{% endif %}>
              {% if section.settings.show_password_toggle %}
                <button type="button" class="sp-pw__visibility" data-password-toggle aria-controls="{{ pw_password_id }}" aria-pressed="false" aria-label="{{ section.settings.show_password_label | escape }}" data-show-label="{{ section.settings.show_password_label | escape }}" data-hide-label="{{ section.settings.hide_password_label | escape }}">
                  <span data-password-toggle-text>{{ section.settings.show_password_label | escape }}</span>
                </button>
              {% endif %}
            </div>
            <button type="submit" class="sp-button sp-button--secondary sp-pw__submit sp-pw__enter"><span>{{ section.settings.password_button_label | escape }}</span>{% render 'sp-password-icon', name: 'arrow-right' %}</button>
          {% endform %}
          {% if section.settings.access_text != blank %}<p class="sp-pw__access-note">{{ section.settings.access_text | escape }}</p>{% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  {% if show_bottom and count_features > 0 %}
    <div class="sp-pw__features">
      <div class="sp-pw__features-grid">
        {% for block in section.blocks %}
          {% if block.type == 'feature' %}
            <div class="sp-pw__feature{% unless block.settings.show_on_desktop %} sp-pw__hide-desktop{% endunless %}{% unless block.settings.show_on_mobile %} sp-pw__hide-mobile{% endunless %}" {{ block.shopify_attributes }}>
              <div class="sp-pw__icon-bubble sp-pw__feature-icon">
                {% if block.settings.icon_image != blank %}{{ block.settings.icon_image | image_url: width: 100 | image_tag: width: 28, height: 28, alt: '', loading: 'lazy' }}{% else %}{% render 'sp-password-icon', name: block.settings.icon %}{% endif %}
              </div>
              <div class="sp-pw__feature-copy"><strong>{{ block.settings.title | escape }}</strong><p>{{ block.settings.description | escape }}</p></div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  {% endif %}
  {% if section.settings.footer_style != 'hidden' %}
    <footer class="sp-pw__footer">
      <div class="sp-pw__copyright">&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright_name | default: shop.name | escape }}. {{ section.settings.copyright_suffix | escape }}
        {% if section.settings.show_privacy_link and shop.privacy_policy.url != blank %}<a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | default: 'Privacy policy' | escape }}</a>{% endif %}
      </div>
      {% if section.settings.show_powered_by %}<div class="sp-pw__powered">{{ section.settings.powered_by_prefix | escape }} <strong>{{ section.settings.powered_by_name | escape }}</strong></div>{% endif %}
      {% if section.settings.show_social_links %}
        <nav class="sp-pw__social" aria-label="Social media links">
          {% assign networks = 'instagram,facebook,pinterest,youtube,tiktok,twitter,linkedin' | split: ',' %}
          {% for network in networks %}
            {% assign setting_key = 'social_' | append: network %}
            {% assign network_url = settings[setting_key] %}
            {% case network %}
              {% when 'instagram' %}{% if section.settings.instagram_url != blank %}{% assign network_url = section.settings.instagram_url %}{% endif %}
              {% when 'facebook' %}{% if section.settings.facebook_url != blank %}{% assign network_url = section.settings.facebook_url %}{% endif %}
              {% when 'pinterest' %}{% if section.settings.pinterest_url != blank %}{% assign network_url = section.settings.pinterest_url %}{% endif %}
              {% when 'youtube' %}{% if section.settings.youtube_url != blank %}{% assign network_url = section.settings.youtube_url %}{% endif %}
            {% endcase %}
            {% if network_url != blank %}<a href="{{ network_url }}" aria-label="{{ network | capitalize }}" {% if settings.social_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}>{% render 'sp-password-icon', name: network %}</a>{% endif %}
          {% endfor %}
        </nav>
      {% endif %}
    </footer>
  {% endif %}
</section>
<script src="{{ 'sp-main-password.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "Main password",
  "tag": "section",
  "class": "sp-password-section",
  "max_blocks": 12,
  "settings": [
    {"type":"header","content":"Theme and visual preset"},
    {"type":"color_scheme","id":"sp_color_scheme","label":"Spider global color scheme","default":"scheme-1"},
    {"type":"select","id":"accent_source","label":"Accent color source","default":"global","options":[{"value":"global","label":"Spider global accent"},{"value":"custom","label":"Custom color"}]},
    {"type":"color","id":"accent_color","label":"Custom accent","default":"#0754ff"},
    {"type":"color","id":"stage_background","label":"Background fallback color","default":"#f2eeeb"},
    {"type":"color","id":"feature_background","label":"Bottom feature bar color","default":"#ffffff"},
    {"type":"color","id":"icon_background","label":"Icon circle background","default":"#e9eaf0"},
    {"type":"checkbox","id":"show_blue_accent","label":"Show decorative blue arc when no reference artwork","default":false},
    {"type":"header","content":"Layout and sizing"},
    {"type":"checkbox","id":"full_height","label":"At least full viewport height","default":true},
    {"type":"range","id":"stage_height","label":"Minimum desktop hero height","min":620,"max":1000,"step":10,"unit":"px","default":780},
    {"type":"range","id":"content_width","label":"Form and content width","min":480,"max":800,"step":10,"unit":"px","default":610},
    {"type":"range","id":"max_container","label":"Feature and footer max width","min":1000,"max":1700,"step":20,"unit":"px","default":1500},
    {"type":"select","id":"content_alignment","label":"Content alignment","default":"center","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}]},
    {"type":"range","id":"component_gap","label":"Content gap","min":8,"max":32,"step":2,"unit":"px","default":16},
    {"type":"select","id":"radius_source","label":"Card radius source","default":"global","options":[{"value":"global","label":"Spider global radius"},{"value":"custom","label":"Custom radius"}]},
    {"type":"range","id":"card_radius","label":"Custom card radius","min":0,"max":32,"step":2,"unit":"px","default":12},
    {"type":"header","content":"Brand logo"},
    {"type":"checkbox","id":"use_alternate_logo","label":"Use custom password page logo","default":false},
    {"type":"image_picker","id":"password_logo","label":"Custom password logo"},
    {"type":"checkbox","id":"show_reference_logo","label":"Use included Spider demo logo if no logo configured","default":true},
    {"type":"range","id":"logo_width_desktop","label":"Desktop logo width","min":70,"max":300,"step":10,"unit":"px","default":160},
    {"type":"range","id":"logo_width_mobile","label":"Mobile logo width","min":70,"max":240,"step":10,"unit":"px","default":130},
    {"type":"header","content":"Hero content"},
    {"type":"text","id":"eyebrow","label":"Optional eyebrow"},
    {"type":"text","id":"heading","label":"Main heading","default":"We're Launching Soon"},
    {"type":"richtext","id":"subheading","label":"Subheading","default":"<p>Our store is almost ready. Join our list to be the first to know when we launch, or enter with a password.</p>"},
    {"type":"range","id":"heading_size","label":"Desktop heading size","min":32,"max":80,"step":2,"unit":"px","default":56},
    {"type":"range","id":"heading_size_mobile","label":"Mobile heading size","min":24,"max":48,"step":2,"unit":"px","default":32},
    {"type":"range","id":"body_size","label":"Desktop description size","min":14,"max":24,"step":1,"unit":"px","default":18},
    {"type":"range","id":"body_size_mobile","label":"Mobile description size","min":12,"max":20,"step":1,"unit":"px","default":15},
    {"type":"checkbox","id":"show_password_message","label":"Show Shopify password message","default":false},
    {"type":"header","content":"Background imagery"},
    {"type":"image_picker","id":"background_image","label":"Optional desktop background image"},
    {"type":"image_picker","id":"mobile_background_image","label":"Optional mobile background image"},
    {"type":"select","id":"background_position","label":"Image focal position","default":"center","options":[{"value":"center","label":"Center"},{"value":"left","label":"Left"},{"value":"right","label":"Right"},{"value":"top","label":"Top"},{"value":"bottom","label":"Bottom"}]},
    {"type":"range","id":"overlay_opacity","label":"Background overlay opacity","min":0,"max":60,"step":5,"unit":"%","default":0},
    {"type":"header","content":"Live countdown"},
    {"type":"checkbox","id":"show_countdown","label":"Enable countdown","default":true},
    {"type":"text","id":"countdown_heading","label":"Countdown heading","default":"Launching in"},
    {"type":"text","id":"launch_iso","label":"Launch ISO 8601 date with UTC offset","default":"2026-11-28T10:00:00+06:00","info":"Example: 2026-11-28T10:00:00+06:00. Date must include a timezone offset or Z."},
    {"type":"text","id":"launch_timezone","label":"Display timezone (IANA)","default":"Asia/Dhaka","info":"Examples: Asia/Dhaka, Europe/London, America/New_York."},
    {"type":"text","id":"countdown_expired","label":"Expired / invalid countdown message","default":"We're launching soon!"},
    {"type":"text","id":"days_label","label":"Days label","default":"DAYS"},
    {"type":"text","id":"hours_label","label":"Hours label","default":"HOURS"},
    {"type":"text","id":"minutes_label","label":"Minutes label","default":"MINUTES"},
    {"type":"text","id":"seconds_label","label":"Seconds label","default":"SECONDS"},
    {"type":"color","id":"countdown_card_color","label":"Countdown card color","default":"#ffffff"},
    {"type":"range","id":"countdown_gap","label":"Gap between countdown cards","min":6,"max":24,"step":2,"unit":"px","default":12},
    {"type":"checkbox","id":"show_benefits","label":"Show benefit blocks","default":true},
    {"type":"checkbox","id":"show_benefit_dividers","label":"Show benefit dividers","default":true},
    {"type":"header","content":"Launch date information"},
    {"type":"checkbox","id":"show_launch_date","label":"Show launch date","default":true},
    {"type":"text","id":"launch_date_label","label":"Launch date prefix","default":"Launch date:"},
    {"type":"text","id":"launch_date_text","label":"Manual launch date override","info":"Leave blank to automatically display the date/time from the countdown."},
    {"type":"header","content":"Email signup"},
    {"type":"checkbox","id":"show_newsletter","label":"Enable newsletter signup","default":true},
    {"type":"text","id":"newsletter_heading","label":"Optional newsletter heading"},
    {"type":"text","id":"email_label","label":"Accessible email label","default":"Email address"},
    {"type":"text","id":"email_placeholder","label":"Email placeholder","default":"Enter your email address"},
    {"type":"text","id":"newsletter_button_label","label":"Submit button","default":"Notify me"},
    {"type":"text","id":"newsletter_text","label":"Text below email form","default":"Be the first to know about new arrivals, exclusive offers and more."},
    {"type":"text","id":"newsletter_success","label":"Newsletter success message","default":"Thank you! You're on the list."},
    {"type":"header","content":"Store password access"},
    {"type":"checkbox","id":"show_password_form","label":"Display store password form","default":true},
    {"type":"checkbox","id":"show_or","label":"Show OR divider","default":true},
    {"type":"text","id":"or_text","label":"Divider text","default":"OR"},
    {"type":"text","id":"access_heading","label":"Optional access heading"},
    {"type":"text","id":"password_label","label":"Accessible password label","default":"Store password"},
    {"type":"text","id":"password_placeholder","label":"Password placeholder","default":"Enter store password"},
    {"type":"text","id":"password_button_label","label":"Password submit button","default":"Enter with password"},
    {"type":"text","id":"access_text","label":"Optional text below password form"},
    {"type":"checkbox","id":"show_password_toggle","label":"Allow show/hide password","default":false},
    {"type":"text","id":"show_password_label","label":"Show-password label","default":"Show"},
    {"type":"text","id":"hide_password_label","label":"Hide-password label","default":"Hide"},
    {"type":"header","content":"Benefits and features"},
    {"type":"range","id":"icon_size","label":"Benefit and feature icon size","min":18,"max":36,"step":2,"unit":"px","default":24},
    {"type":"checkbox","id":"show_features","label":"Show bottom feature bar","default":true},
    {"type":"checkbox","id":"show_feature_dividers","label":"Show feature dividers","default":true},
    {"type":"header","content":"Footer"},
    {"type":"select","id":"footer_style","label":"Footer visibility","default":"minimal","options":[{"value":"minimal","label":"Show footer"},{"value":"hidden","label":"Hide footer"}]},
    {"type":"text","id":"copyright_name","label":"Copyright name (blank = shop name)"},
    {"type":"text","id":"copyright_suffix","label":"Copyright suffix","default":"All rights reserved."},
    {"type":"checkbox","id":"show_powered_by","label":"Show powered by text","default":true},
    {"type":"text","id":"powered_by_prefix","label":"Powered-by prefix","default":"Powered by"},
    {"type":"text","id":"powered_by_name","label":"Powered-by name","default":"Spider Theme"},
    {"type":"checkbox","id":"show_social_links","label":"Use Spider global social URLs","default":true},
    {"type":"url","id":"instagram_url","label":"Instagram URL override"},
    {"type":"url","id":"facebook_url","label":"Facebook URL override"},
    {"type":"url","id":"pinterest_url","label":"Pinterest URL override"},
    {"type":"url","id":"youtube_url","label":"YouTube URL override"},
    {"type":"checkbox","id":"show_privacy_link","label":"Show privacy policy link","default":false},
    {"type":"header","content":"Responsive spacing"},
    {"type":"select","id":"spacing_source","label":"Spacing source","default":"theme","options":[{"value":"theme","label":"Reference-friendly theme spacing"},{"value":"custom","label":"Custom"}]},
    {"type":"range","id":"padding_top","label":"Desktop top padding","min":0,"max":120,"step":4,"unit":"px","default":20},
    {"type":"range","id":"padding_bottom","label":"Desktop bottom padding","min":0,"max":120,"step":4,"unit":"px","default":40},
    {"type":"range","id":"padding_top_mobile","label":"Mobile top padding","min":0,"max":120,"step":4,"unit":"px","default":32},
    {"type":"range","id":"padding_bottom_mobile","label":"Mobile bottom padding","min":0,"max":120,"step":4,"unit":"px","default":48}
  ],
  "blocks": [

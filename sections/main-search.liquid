{% render 'sp-section-color-scheme', section: section %}
{{ 'sp-main-search.css' | asset_url | stylesheet_tag }}
<section class="sp-free-main-search" data-section-id="{{ section.id }}">
  <div class="sp-container">
    <header class="sp-free-search-header">
      <h1>{{ section.settings.heading | escape }}</h1>
      <form action="{{ routes.search_url }}" method="get" role="search" class="sp-free-search-form">
        <label class="visually-hidden" for="Search-{{ section.id }}">Search products and pages</label>
        <input id="Search-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.placeholder | escape }}">
        <input type="hidden" name="options[prefix]" value="last">
        <button type="submit" class="sp-button sp-button--primary">{{ section.settings.button_label | escape }}</button>
      </form>
      {% if search.performed %}<p>{{ search.results_count }} results for “{{ search.terms | escape }}”</p>{% endif %}
    </header>
    {% if search.performed %}
      {% paginate search.results by section.settings.results_per_page %}
        <div class="sp-free-search-grid" style="--sp-free-cols:{{ section.settings.columns_desktop }};">
          {% for result in search.results %}
            {% if result.object_type == 'product' %}
              {% render 'product-card', card_product: result %}
            {% elsif result.object_type == 'article' %}
              {% render 'sp-article-card', article: result, show_date: true, show_author: false, show_excerpt: true, show_tags: true %}
            {% else %}
              <article class="sp-free-search-page">
                <h2><a href="{{ result.url }}">{{ result.title | escape }}</a></h2>
                <p>{{ result.content | strip_html | truncatewords: 24 }}</p>
              </article>
            {% endif %}
          {% else %}
            <p>No results found. Try a different search term.</p>
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}<nav class="sp-free-pagination" aria-label="Pagination">{{ paginate | default_pagination }}</nav>{% endif %}
      {% endpaginate %}
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Main search",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "sp_color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Search" },
    { "type": "text", "id": "placeholder", "label": "Search placeholder", "default": "Search products, articles and pages" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Search" },
    { "type": "range", "id": "results_per_page", "label": "Results per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns_desktop", "label": "Desktop columns", "min": 2, "max": 5, "step": 1, "default": 4 }
  ]
}
{% endschema %}

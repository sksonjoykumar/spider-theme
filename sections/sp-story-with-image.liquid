{% render 'sp-section-color-scheme', section: section %}
{{ 'sp-content-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign story_style = section.settings.layout_style | default: 'original'
  assign desktop_class = 'sp-story-with-image--image-right'
  if section.settings.image_position == 'left'
    assign desktop_class = 'sp-story-with-image--image-left'
  endif
  assign mobile_class = 'sp-story-with-image--mobile-image-last'
  if section.settings.mobile_image_position == 'first'
    assign mobile_class = 'sp-story-with-image--mobile-image-first'
  endif
  assign story_width_class = ''
  if section.settings.container_width == 'wide'
    assign story_width_class = 'sp-container--wide'
  elsif section.settings.container_width == 'narrow'
    assign story_width_class = 'sp-container--narrow'
  endif
  assign story_button_style = section.settings.button_style | default: 'primary'
  assign story_image = section.settings.image
  if story_image == blank and section.settings.mobile_image != blank
    assign story_image = section.settings.mobile_image
  endif
  assign story_image_loading = section.settings.image_loading | default: 'auto'
  if story_image_loading == 'auto'
    if story_style == 'original'
      assign story_image_loading = 'eager'
    else
      assign story_image_loading = 'lazy'
    endif
  endif
  assign content_percent = section.settings.content_ratio | default: 42
  assign media_percent = 100 | minus: content_percent
  assign story_radius = 'var(--sp-radius-lg, 16px)'
  unless section.settings.use_global_radius
    assign story_radius = section.settings.custom_image_radius | append: 'px'
  endunless
  assign story_media_ratio = section.settings.image_ratio | default: '3_2'
  assign story_mobile_ratio = section.settings.mobile_image_ratio | default: '4_3'
-%}

<section
  class="sp-section sp-story-with-image sp-story-with-image--{{ story_style | escape }} {{ desktop_class }} {{ mobile_class }}{% if section.settings.mobile_button_full %} sp-story-with-image--mobile-button-full{% endif %}"
  data-section-id="{{ section.id }}"
  aria-labelledby="SpStoryWithImageTitle-{{ section.id }}"
  style="
    --sp-story-columns: minmax(0, {{ content_percent }}fr) minmax(0, {{ media_percent }}fr);
    --sp-story-column-gap: {{ section.settings.column_gap }}px;
    --sp-story-mobile-gap: {{ section.settings.mobile_gap }}px;
    --sp-story-heading-size: {{ section.settings.heading_size }}px;
    --sp-story-mobile-heading-size: {{ section.settings.mobile_heading_size }}px;
    --sp-story-body-size: {{ section.settings.description_size }}px;
    --sp-story-mobile-body-size: {{ section.settings.mobile_description_size }}px;
    --sp-story-eyebrow-size: {{ section.settings.eyebrow_size }}px;
    --sp-story-text-width: {{ section.settings.content_max_width }}px;
    --sp-story-check-gap: {{ section.settings.check_gap }}px;
    --sp-story-check-text-size: {{ section.settings.check_text_size }}px;
    --sp-story-icon-size: {{ section.settings.check_icon_size }}px;
    --sp-story-button-gap: {{ section.settings.button_top_gap }}px;
    --sp-story-image-radius: {{ story_radius }};
    --sp-story-image-fit: {{ section.settings.image_fit }};
    --sp-story-image-position-x: {{ section.settings.image_position_x }}%;
    --sp-story-image-position-y: {{ section.settings.image_position_y }}%;
    --sp-story-mobile-image-position-x: {{ section.settings.mobile_position_x }}%;
    --sp-story-mobile-image-position-y: {{ section.settings.mobile_position_y }}%;
    --sp-story-image-ratio: {% case story_media_ratio %}{% when '16_10' %}1.6{% when '4_3' %}1.3333{% when 'square' %}1{% else %}1.5{% endcase %};
    --sp-story-mobile-image-ratio: {% case story_mobile_ratio %}{% when 'square' %}1{% when '3_2' %}1.5{% else %}1.3333{% endcase %};
    {% unless section.settings.use_global_spacing %}
      --sp-story-padding-top: {{ section.settings.padding_top }}px;
      --sp-story-padding-bottom: {{ section.settings.padding_bottom }}px;
      --sp-story-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
      --sp-story-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    {% endunless %}
  "
>
  <div class="sp-container {{ story_width_class }} sp-story-with-image__grid">
    <div class="sp-story-with-image__content">
      {% if section.settings.eyebrow != blank %}
        <p class="sp-content-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      <h2 id="SpStoryWithImageTitle-{{ section.id }}" class="sp-story-with-image__title">
        {{ section.settings.heading | escape }}
      </h2>

      {% if section.settings.text != blank %}
        <div class="sp-content-copy rte">{{ section.settings.text }}</div>
      {% endif %}

      {% if section.settings.show_checklist and section.blocks.size > 0 %}
        <ul class="sp-content-checks" role="list">
          {% for block in section.blocks %}
            {% if block.settings.text != blank %}
              <li class="sp-content-check" {{ block.shopify_attributes }}>
                {% render 'sp-content-icon', name: 'check', class: 'sp-content-check__icon' %}
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      {% endif %}

      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <div class="sp-content-actions">
          {% capture story_button_content %}
            {{ section.settings.button_label | escape }}
            {% if section.settings.show_button_arrow and story_style != 'original' %}
              <svg class="sp-story-with-image__button-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {% endif %}
          {% endcapture %}
          {% render 'button', label: story_button_content, href: section.settings.button_link, style: story_button_style, class: 'sp-story-with-image__button' %}
        </div>
      {% endif %}
    </div>

    <div class="sp-story-with-image__media">
      <div class="sp-content-media{% if section.settings.image_ratio == 'natural' and story_style != 'original' %} sp-story-with-image__media--natural{% endif %}">
        {% if story_image != blank %}
          {% if section.settings.mobile_image != blank %}
            <picture>
              <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 360 }} 360w, {{ section.settings.mobile_image | image_url: width: 540 }} 540w, {{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 990 }} 990w" sizes="(max-width: 749px) calc(100vw - 32px), 100vw">
              {% render 'responsive-image', image: story_image, widths: '480, 640, 800, 1000, 1200, 1440, 1600, 2000', sizes: '(min-width: 990px) min(58vw, 1000px), (min-width: 750px) 55vw, calc(100vw - 32px)', loading: story_image_loading, class: 'sp-content-media__image', alt: section.settings.image_alt %}
            </picture>
          {% else %}
            {% render 'responsive-image', image: story_image, widths: '480, 640, 800, 1000, 1200, 1440, 1600, 2000', sizes: '(min-width: 990px) min(58vw, 1000px), (min-width: 750px) 55vw, calc(100vw - 32px)', loading: story_image_loading, class: 'sp-content-media__image', alt: section.settings.image_alt %}
          {% endif %}
        {% else %}
          {% render 'placeholder-image', name: 'lifestyle-1', class: 'sp-placeholder' %}
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% schema %}

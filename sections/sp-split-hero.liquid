{% render 'sp-section-color-scheme', section: section %}
{{ 'sp-split-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sp-split-hero.js' | asset_url }}" defer></script>

{%- liquid
  assign slide_count = 0
  assign feature_count = 0
  assign slide_index = 0
  assign top_overlay_opacity = section.settings.top_overlay_opacity
  if section.settings.top_overlay_enabled == false
    assign top_overlay_opacity = 0
  endif
  assign image_loading = 'lazy'
  if section.location == 'template' and section.index == 1
    assign image_loading = 'eager'
  endif

  for block in section.blocks
    if block.type == 'slide'
      assign slide_count = slide_count | plus: 1
    elsif block.type == 'feature'
      assign feature_count = feature_count | plus: 1
    endif
  endfor
-%}

<section
  id="SpSplitHero-{{ section.id }}"
  class="sp-split-hero{% if section.settings.section_width == 'contained' %} sp-split-hero--contained{% endif %}"
  data-sp-split-hero
  data-autoplay="{{ section.settings.autoplay }}"
  data-interval="{{ section.settings.slide_interval | times: 1000 }}"
  data-pause-hover="{{ section.settings.pause_on_hover }}"
  style="
    --sp-sh-panel-gap: {{ section.settings.panel_gap }}px;
    --sp-sh-max-width: {{ section.settings.max_width }}px;
    --sp-sh-radius: {{ section.settings.container_radius }}px;
    --sp-sh-heading-size-d: {{ section.settings.heading_size_desktop }}px;
    --sp-sh-heading-size-m: {{ section.settings.heading_size_mobile }}px;
    --sp-sh-content-max: {{ section.settings.content_max_width }}px;
    --sp-sh-top-height: {{ section.settings.top_height }}px;
    --sp-sh-top-height-m: {{ section.settings.top_mobile_height }}px;
    --sp-sh-slide-height: {{ section.settings.slideshow_height }}px;
    --sp-sh-slide-height-m: {{ section.settings.slideshow_mobile_height }}px;
    --sp-sh-split-height: {{ section.settings.split_height }}px;
    --sp-sh-split-height-m: {{ section.settings.split_mobile_image_height }}px;
    --sp-sh-split-content-width: {{ section.settings.split_content_width }}%;
    --sp-sh-feature-icon-size: {{ section.settings.feature_icon_size }}px;
  "
>
  <div class="sp-split-hero__inner">
    {%- if section.settings.enable_top_panel -%}
      {%- liquid
        assign top_image = section.settings.top_image
        if top_image == blank
          assign top_image = section.settings.top_mobile_image
        endif
      -%}
      <div class="sp-split-hero__panel sp-split-hero__banner" style="--sp-sh-overlay-color: {{ section.settings.top_overlay_color }}; --sp-sh-overlay-opacity: {{ top_overlay_opacity | times: 0.01 }}; --sp-sh-image-position: {{ section.settings.top_image_position }};">
        <div class="sp-split-hero__media{% if top_overlay_opacity > 0 %} sp-split-hero__media--overlay{% endif %}" aria-hidden="true">
          {%- if top_image != blank -%}
            <picture>
              {%- if section.settings.top_mobile_image != blank -%}
                <source media="(max-width: 749px)" srcset="{{ section.settings.top_mobile_image | image_url: width: 1200 }}">
              {%- endif -%}
              {{ top_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: image_loading, class: 'sp-split-hero__image', alt: '' }}
            </picture>
          {%- else -%}
            <div class="sp-split-hero__image-placeholder sp-split-hero__image-placeholder--warm"></div>
          {%- endif -%}
        </div>

        <div class="sp-split-hero__content-shell sp-split-hero__content-shell--{{ section.settings.top_content_alignment }} sp-split-hero__content-shell--valign-{{ section.settings.top_vertical_alignment }}">
          <div class="sp-split-hero__content sp-split-hero__content--{{ section.settings.top_text_color }}">
            {%- if section.settings.top_eyebrow != blank -%}
              <p class="sp-split-hero__eyebrow">{{ section.settings.top_eyebrow | escape }}</p>
            {%- endif -%}
            {%- if section.settings.top_heading != blank -%}
              <h2 class="sp-split-hero__heading">{{ section.settings.top_heading | escape | newline_to_br }}</h2>
            {%- endif -%}
            {%- if section.settings.top_description != blank -%}
              <div class="sp-split-hero__description rte">{{ section.settings.top_description }}</div>
            {%- endif -%}
            {%- if section.settings.top_primary_label != blank or section.settings.top_secondary_label != blank -%}
              <div class="sp-split-hero__actions">
                {%- if section.settings.top_primary_label != blank -%}
                  <a class="sp-button sp-button--primary sp-split-hero__button" href="{{ section.settings.top_primary_url | default: routes.all_products_collection_url }}">
                    <span>{{ section.settings.top_primary_label | escape }}</span>
                    {%- if section.settings.show_button_arrows -%}<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3.5 10h12m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endif -%}
                  </a>
                {%- endif -%}
                {%- if section.settings.top_secondary_label != blank -%}
                  <a class="sp-button sp-button--secondary sp-split-hero__button" href="{{ section.settings.top_secondary_url | default: routes.root_url }}">
                    <span>{{ section.settings.top_secondary_label | escape }}</span>
                    {%- if section.settings.show_button_arrows -%}<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3.5 10h12m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{%- endif -%}
                  </a>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.enable_slideshow -%}
      {%- if slide_count > 0 -%}
        <div class="sp-split-hero__slideshow" data-sp-slideshow aria-roledescription="carousel" aria-label="{{ section.settings.slideshow_accessible_label | escape }}" style="--sp-sh-overlay-color: {{ section.settings.slideshow_overlay_color }};">
          <div class="sp-split-hero__slides">
            {%- for block in section.blocks -%}
              {%- if block.type == 'slide' -%}
                {%- liquid
                  assign slide_image = block.settings.image
                  if slide_image == blank
                    assign slide_image = block.settings.mobile_image
                  endif
                -%}
                <article
                  class="sp-split-hero__slide{% if slide_index == 0 %} is-active{% endif %}"
                  data-sp-slide
                  data-sp-slide-index="{{ slide_index }}"
                  aria-hidden="{% if slide_index == 0 %}false{% else %}true{% endif %}"
                  style="--sp-sh-overlay-opacity: {{ block.settings.overlay_opacity | times: 0.01 }}; --sp-sh-image-position: {{ block.settings.image_position }};"
                  {{ block.shopify_attributes }}
                >
                  <div class="sp-split-hero__media{% if block.settings.overlay_opacity > 0 %} sp-split-hero__media--overlay{% endif %}" aria-hidden="true">
                    {%- if slide_image != blank -%}
                      <picture>
                        {%- if block.settings.mobile_image != blank -%}
                          <source media="(max-width: 749px)" srcset="{{ block.settings.mobile_image | image_url: width: 1200 }}">
                        {%- endif -%}
                        {{ slide_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'lazy', class: 'sp-split-hero__image', alt: '' }}
                      </picture>
                    {%- else -%}
                      <div class="sp-split-hero__image-placeholder sp-split-hero__image-placeholder--blue"></div>
                    {%- endif -%}
                  </div>
                  <div class="sp-split-hero__content-shell sp-split-hero__content-shell--{{ block.settings.content_alignment }} sp-split-hero__content-shell--valign-{{ block.settings.vertical_alignment }}">
                    <div class="sp-split-hero__content sp-split-hero__content--{{ block.settings.text_color }}">
                      {%- if block.settings.eyebrow != blank -%}<p class="sp-split-hero__eyebrow">{{ block.settings.eyebrow | escape }}</p>{%- endif -%}
                      {%- if block.settings.heading != blank -%}<h2 class="sp-split-hero__heading">{{ block.settings.heading | escape | newline_to_br }}</h2>{%- endif -%}
                      {%- if block.settings.description != blank -%}<div class="sp-split-hero__description rte">{{ block.settings.description }}</div>{%- endif -%}
                      {%- if block.settings.primary_label != blank or block.settings.secondary_label != blank -%}
                        <div class="sp-split-hero__actions">
                          {%- if block.settings.primary_label != blank -%}
                            <a class="sp-button sp-button--primary sp-split-hero__button" href="{{ block.settings.primary_url | default: routes.all_products_collection_url }}"><span>{{ block.settings.primary_label | escape }}</span>{% if section.settings.show_button_arrows %}<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3.5 10h12m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endif %}</a>
                          {%- endif -%}
                          {%- if block.settings.secondary_label != blank -%}
                            <a class="sp-button sp-button--secondary sp-split-hero__button" href="{{ block.settings.secondary_url | default: routes.root_url }}"><span>{{ block.settings.secondary_label | escape }}</span>{% if section.settings.show_button_arrows %}<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3.5 10h12m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endif %}</a>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    </div>
                  </div>
                </article>
                {%- assign slide_index = slide_index | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if slide_count > 1 and section.settings.show_arrows -%}
            <button class="sp-split-hero__arrow sp-split-hero__arrow--prev" type="button" data-sp-prev aria-label="Previous slide">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button class="sp-split-hero__arrow sp-split-hero__arrow--next" type="button" data-sp-next aria-label="Next slide">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          {%- endif -%}

          {%- if slide_count > 1 and section.settings.show_dots -%}
            <div class="sp-split-hero__dots" role="group" aria-label="Choose slide">
              {%- assign dot_index = 0 -%}
              {%- for block in section.blocks -%}
                {%- if block.type == 'slide' -%}
                  <button class="sp-split-hero__dot{% if dot_index == 0 %} is-active{% endif %}" type="button" data-sp-dot data-sp-slide-index="{{ dot_index }}" aria-label="Go to slide {{ dot_index | plus: 1 }}" aria-pressed="{% if dot_index == 0 %}true{% else %}false{% endif %}"></button>
                  {%- assign dot_index = dot_index | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- elsif request.design_mode -%}
        <div class="sp-split-hero__empty-slide" style="min-height: var(--sp-sh-slide-height);">Add at least one Slide block to display the slideshow.</div>
      {%- endif -%}
    {%- endif -%}

    {%- if section.settings.enable_split_panel -%}
      {%- liquid
        assign split_image = section.settings.split_image
        if split_image == blank
          assign split_image = section.settings.split_mobile_image
        endif
      -%}
      <div class="sp-split-hero__split sp-split-hero__split--image-{{ section.settings.split_image_side }} sp-split-hero__split--mobile-{{ section.settings.split_mobile_order }}{% if section.settings.use_custom_split_background %} sp-split-hero__split--custom-background{% endif %}" style="--sp-sh-split-bg: {{ section.settings.split_custom_background }}; --sp-sh-split-image-position: {{ section.settings.split_image_position }};">
        <div class="sp-split-hero__split-content sp-split-hero__content--{{ section.settings.split_text_color }}">
          <div class="sp-split-hero__split-content-inner">
            {%- if section.settings.split_eyebrow != blank -%}<p class="sp-split-hero__eyebrow">{{ section.settings.split_eyebrow | escape }}</p>{%- endif -%}
            {%- if section.settings.split_heading != blank -%}<h2 class="sp-split-hero__heading">{{ section.settings.split_heading | escape | newline_to_br }}</h2>{%- endif -%}
            {%- if section.settings.split_description != blank -%}<div class="sp-split-hero__description rte">{{ section.settings.split_description }}</div>{%- endif -%}
            {%- if section.settings.split_primary_label != blank or section.settings.split_secondary_label != blank -%}
              <div class="sp-split-hero__actions">
                {%- if section.settings.split_primary_label != blank -%}
                  <a class="sp-button sp-button--primary sp-split-hero__button" href="{{ section.settings.split_primary_url | default: routes.all_products_collection_url }}"><span>{{ section.settings.split_primary_label | escape }}</span>{% if section.settings.show_button_arrows %}<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3.5 10h12m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endif %}</a>
                {%- endif -%}
                {%- if section.settings.split_secondary_label != blank -%}
                  <a class="sp-button sp-button--secondary sp-split-hero__button" href="{{ section.settings.split_secondary_url | default: routes.root_url }}"><span>{{ section.settings.split_secondary_label | escape }}</span>{% if section.settings.show_button_arrows %}<svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3.5 10h12m-5-5 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endif %}</a>
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if feature_count > 0 and section.settings.show_features -%}
              <div class="sp-split-hero__features">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'feature' -%}
                    <div class="sp-split-hero__feature" {{ block.shopify_attributes }}>
                      <span class="sp-split-hero__feature-icon" aria-hidden="true">
                        {%- case block.settings.icon -%}
                          {%- when 'leaf' -%}<svg viewBox="0 0 24 24"><path d="M20.5 3.5C11 3.5 5 6.8 4 13.1c-.5 3.2 1.7 5.8 4.8 5.4C15.4 17.7 19.8 11.4 20.5 3.5Z"/><path d="M3 22c3.4-6.1 7.1-9.7 12.2-13.1"/></svg>
                          {%- when 'truck' -%}<svg viewBox="0 0 24 24"><path d="M2 5h12v12H2zM14 9h4l4 4v4h-8z"/><circle cx="6.5" cy="19" r="2"/><circle cx="18.5" cy="19" r="2"/></svg>
                          {%- when 'shield' -%}<svg viewBox="0 0 24 24"><path d="M12 2.5 20 5.8v5.6c0 5.1-3.5 8.3-8 10.1-4.5-1.8-8-5-8-10.1V5.8L12 2.5Z"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg>
                          {%- when 'recycle' -%}<svg viewBox="0 0 24 24"><path d="m8.5 5 2-3 3.3 5.7M4 13l-2-3.4L8.5 9M15.5 18l-2 3-3.3-5.7M20 10l2 3.4-6.5.6M6.2 7.8l-2.4 4.1 2.4 4.2M17.8 16.2l2.4-4.1-2.4-4.2"/></svg>
                          {%- when 'heart' -%}<svg viewBox="0 0 24 24"><path d="M20.5 8.7c0 5.1-8.5 11-8.5 11s-8.5-5.9-8.5-11A4.6 4.6 0 0 1 12 6.1a4.6 4.6 0 0 1 8.5 2.6Z"/></svg>
                          {%- when 'droplet' -%}<svg viewBox="0 0 24 24"><path d="M12 2.5S5.5 10 5.5 14.5a6.5 6.5 0 0 0 13 0C18.5 10 12 2.5 12 2.5Z"/><path d="M9 15.5a3 3 0 0 0 3 3"/></svg>
                          {%- when 'globe' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5"/><path d="M2.8 12h18.4M12 2.5c2.7 2.8 4 6 4 9.5s-1.3 6.7-4 9.5c-2.7-2.8-4-6-4-9.5s1.3-6.7 4-9.5Z"/></svg>
                          {%- when 'package' -%}<svg viewBox="0 0 24 24"><path d="m12 2.5 9 4.7v9.6l-9 4.7-9-4.7V7.2l9-4.7Z"/><path d="m3.5 7.5 8.5 4.6 8.5-4.6M12 12.1v9.1M7.5 4.8l9 4.8"/></svg>
                          {%- when 'sun' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2.2M12 19.8V22M4.9 4.9l1.6 1.6m11 11 1.6 1.6M2 12h2.2m15.6 0H22M4.9 19.1l1.6-1.6m11-11 1.6-1.6"/></svg>
                          {%- else -%}<svg viewBox="0 0 24 24"><path d="m12 2 1.9 6.1L20 10l-6.1 1.9L12 18l-1.9-6.1L4 10l6.1-1.9L12 2Z"/><path d="m19 16 .9 2.1L22 19l-2.1.9L19 22l-.9-2.1L16 19l2.1-.9L19 16Z"/></svg>
                        {%- endcase -%}
                      </span>
                      <span class="sp-split-hero__feature-copy">
                        {%- if block.settings.title != blank -%}<span class="sp-split-hero__feature-title">{{ block.settings.title | escape }}</span>{%- endif -%}
                        {%- if block.settings.text != blank -%}<span class="sp-split-hero__feature-text">{{ block.settings.text | escape }}</span>{%- endif -%}
                      </span>
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        </div>
        <div class="sp-split-hero__split-media" style="--sp-sh-overlay-color: {{ section.settings.split_overlay_color }}; --sp-sh-overlay-opacity: {{ section.settings.split_overlay_opacity | times: 0.01 }};" aria-hidden="true">
          {%- if split_image != blank -%}
            <picture>
              {%- if section.settings.split_mobile_image != blank -%}
                <source media="(max-width: 749px)" srcset="{{ section.settings.split_mobile_image | image_url: width: 1200 }}">
              {%- endif -%}
              {{ split_image | image_url: width: 2000 | image_tag: widths: '600, 900, 1200, 1600, 2000', sizes: '(min-width: 750px) 55vw, 100vw', loading: 'lazy', class: 'sp-split-hero__image', alt: '' }}
            </picture>
          {%- else -%}
            <div class="sp-split-hero__image-placeholder sp-split-hero__image-placeholder--warm"></div>
          {%- endif -%}
          {%- if section.settings.split_overlay_opacity > 0 -%}<span class="sp-split-hero__media-overlay"></span>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Split Hero",
  "tag": "section",
  "class": "section-sp-split-hero",
  "disabled_on": {
    "groups": ["header", "footer", "custom.system"]
  },
  "settings": [
    { "type": "header", "content": "Spider global design" },
    { "type": "color_scheme", "id": "sp_color_scheme", "label": "Color scheme", "default": "scheme-1", "info": "Uses the shared Spider global color scheme." },
    { "type": "select", "id": "section_width", "label": "Section width", "default": "full_width", "options": [{ "value": "full_width", "label": "Full width" }, { "value": "contained", "label": "Contained" }] },
    { "type": "range", "id": "max_width", "label": "Contained maximum width", "min": 1000, "max": 1800, "step": 100, "unit": "px", "default": 1600 },
    { "type": "range", "id": "container_radius", "label": "Contained corner radius", "min": 0, "max": 32, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "panel_gap", "label": "Space between panels", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "content_max_width", "label": "Text content maximum width", "min": 400, "max": 800, "step": 20, "unit": "px", "default": 560 },
    { "type": "range", "id": "heading_size_desktop", "label": "Heading size — desktop", "min": 30, "max": 64, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size — mobile", "min": 24, "max": 42, "step": 2, "unit": "px", "default": 32 },
    { "type": "checkbox", "id": "show_button_arrows", "label": "Show arrows in CTA buttons", "default": true },

    { "type": "header", "content": "Panel 1 — Lifestyle banner" },
    { "type": "checkbox", "id": "enable_top_panel", "label": "Show top banner", "default": true },
    { "type": "image_picker", "id": "top_image", "label": "Desktop background image" },
    { "type": "image_picker", "id": "top_mobile_image", "label": "Mobile background image" },
    { "type": "select", "id": "top_image_position", "label": "Image focal position", "default": "center center", "options": [{ "value": "center center", "label": "Center" }, { "value": "center top", "label": "Top" }, { "value": "center bottom", "label": "Bottom" }, { "value": "left center", "label": "Left" }, { "value": "right center", "label": "Right" }] },
    { "type": "range", "id": "top_height", "label": "Desktop height", "min": 220, "max": 640, "step": 20, "unit": "px", "default": 320 },
    { "type": "range", "id": "top_mobile_height", "label": "Mobile height", "min": 320, "max": 720, "step": 20, "unit": "px", "default": 420 },
    { "type": "text", "id": "top_eyebrow", "label": "Eyebrow", "default": "NEW COLLECTION" },
    { "type": "textarea", "id": "top_heading", "label": "Heading", "default": "Everyday Essentials\nfor a Better You" },
    { "type": "richtext", "id": "top_description", "label": "Description", "default": "<p>Thoughtfully designed products to bring more simplicity, comfort, and balance into your daily routine.</p>" },
    { "type": "text", "id": "top_primary_label", "label": "Primary button label", "default": "Shop the Collection" },
    { "type": "url", "id": "top_primary_url", "label": "Primary button link" },
    { "type": "text", "id": "top_secondary_label", "label": "Secondary button label", "default": "Learn More" },
    { "type": "url", "id": "top_secondary_url", "label": "Secondary button link" },
    { "type": "select", "id": "top_content_alignment", "label": "Content horizontal alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
    { "type": "select", "id": "top_vertical_alignment", "label": "Content vertical alignment", "default": "center", "options": [{ "value": "top", "label": "Top" }, { "value": "center", "label": "Center" }, { "value": "bottom", "label": "Bottom" }] },
    { "type": "select", "id": "top_text_color", "label": "Text color", "default": "inherit", "options": [{ "value": "inherit", "label": "Use theme colors" }, { "value": "dark", "label": "Dark text" }, { "value": "light", "label": "Light text" }] },
    { "type": "checkbox", "id": "top_overlay_enabled", "label": "Enable image overlay", "default": false },
    { "type": "color", "id": "top_overlay_color", "label": "Overlay color", "default": "#F4E8D7" },
    { "type": "range", "id": "top_overlay_opacity", "label": "Overlay opacity", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 15 },

    { "type": "header", "content": "Panel 2 — Slideshow" },
    { "type": "checkbox", "id": "enable_slideshow", "label": "Show slideshow", "default": true },
    { "type": "text", "id": "slideshow_accessible_label", "label": "Slideshow accessible label", "default": "Featured lifestyle slides" },

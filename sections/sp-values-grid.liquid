{%- comment -%}
  Spider Values Grid — existing section updated in place.
  All section-specific design hooks are scoped to .sp-values-grid.
  Existing setting IDs and `value` blocks are preserved.
{%- endcomment -%}
{% render 'sp-section-color-scheme', section: section %}
{{ 'sp-content-sections.css' | asset_url | stylesheet_tag }}

{% liquid
  assign has_title = false
  if section.settings.show_heading and section.settings.heading != blank
    assign has_title = true
  endif
  assign label_text = section.settings.accessibility_label | default: 'Our values'
  assign has_header = has_title
  if section.settings.show_eyebrow and section.settings.eyebrow != blank
    assign has_header = true
  endif
  if section.settings.show_description and section.settings.description != blank
    assign has_header = true
  endif
%}

<section
  class="sp-section sp-values-grid sp-values-grid--{{ section.settings.card_alignment }} sp-values-grid--hover-{{ section.settings.card_hover }} sp-values-grid--shadow-{{ section.settings.card_shadow }} sp-values-grid--icon-{{ section.settings.icon_shape }}{% if section.settings.columns_tablet == '2' %} sp-values-grid--tablet-two{% endif %}{% unless section.settings.card_border %} sp-values-grid--no-border{% endunless %}"
  data-section-id="{{ section.id }}"
  {% if has_title %}aria-labelledby="SpValuesGridTitle-{{ section.id }}"{% else %}aria-label="{{ label_text | escape }}"{% endif %}
  style="
    --sp-values-col-d: {{ section.settings.columns_desktop }};
    --sp-values-col-t: {{ section.settings.columns_tablet }};
    --sp-values-col-m: {{ section.settings.columns_mobile }};
    {% if section.settings.header_max_width != blank %}--sp-values-header-width: {{ section.settings.header_max_width }}px;{% endif %}
    {% if section.settings.description_max_width != blank %}--sp-values-description-width: {{ section.settings.description_max_width }}px;{% endif %}
    {% if section.settings.grid_gap > 0 %}--sp-values-grid-gap: {{ section.settings.grid_gap }}px;{% endif %}
    {% if section.settings.header_gap != blank %}--sp-values-header-gap: {{ section.settings.header_gap }}px;{% endif %}
    {% if section.settings.card_padding != blank %}--sp-values-card-padding: {{ section.settings.card_padding }}px;{% endif %}
    {% if section.settings.card_min_height != blank %}--sp-values-card-min-height: {{ section.settings.card_min_height }}px;{% endif %}
    {% if section.settings.card_radius > 0 %}--sp-values-card-radius: {{ section.settings.card_radius }}px;{% endif %}
    {% if section.settings.icon_circle_size != blank %}--sp-values-icon-circle: {{ section.settings.icon_circle_size }}px;{% endif %}
    {% if section.settings.icon_size != blank %}--sp-values-icon-size: {{ section.settings.icon_size }}px;{% endif %}
    {% if section.settings.heading_size_desktop > 0 %}--sp-values-heading-size-d: {{ section.settings.heading_size_desktop }}px;{% endif %}
    {% if section.settings.heading_size_mobile > 0 %}--sp-values-heading-size-m: {{ section.settings.heading_size_mobile }}px;{% endif %}
    {% if section.settings.eyebrow_size > 0 %}--sp-values-eyebrow-size: {{ section.settings.eyebrow_size }}px;{% endif %}
    {% if section.settings.description_size > 0 %}--sp-values-description-size: {{ section.settings.description_size }}px;{% endif %}
    {% if section.settings.card_title_size > 0 %}--sp-values-card-title-size: {{ section.settings.card_title_size }}px;{% endif %}
    {% if section.settings.card_text_size > 0 %}--sp-values-card-text-size: {{ section.settings.card_text_size }}px;{% endif %}
    {% if section.settings.padding_top > 0 %}--sp-values-padding-top-d: {{ section.settings.padding_top }}px;{% endif %}
    {% if section.settings.padding_bottom > 0 %}--sp-values-padding-bottom-d: {{ section.settings.padding_bottom }}px;{% endif %}
    {% if section.settings.mobile_padding_top > 0 %}--sp-values-padding-top-m: {{ section.settings.mobile_padding_top }}px;{% endif %}
    {% if section.settings.mobile_padding_bottom > 0 %}--sp-values-padding-bottom-m: {{ section.settings.mobile_padding_bottom }}px;{% endif %}
    {% if section.settings.icon_color_override != blank %}--sp-values-icon-color: {{ section.settings.icon_color_override }};{% endif %}
    {% if section.settings.icon_bg_override != blank %}--sp-values-icon-bg: {{ section.settings.icon_bg_override }};{% endif %}
  "
>
  <div class="sp-container{% if section.settings.container_width == 'wide' %} sp-container--wide{% elsif section.settings.container_width == 'narrow' %} sp-container--narrow{% endif %}">
    {% if has_header %}
      <header class="sp-content-section-header sp-values-grid__header{% if section.settings.header_align == 'left' %} sp-values-grid__header--left{% endif %}">
        {% if section.settings.show_eyebrow and section.settings.eyebrow != blank %}
          <p class="sp-values-grid__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if has_title %}
          <h2 id="SpValuesGridTitle-{{ section.id }}" class="sp-content-section-title sp-values-grid__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.show_description and section.settings.description != blank %}
          <div class="sp-content-section-description rte sp-values-grid__description">{{ section.settings.description }}</div>
        {% endif %}
      </header>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <div class="sp-values-grid__grid" role="list">
        {% for block in section.blocks %}
          <article class="sp-value-card" role="listitem" {{ block.shopify_attributes }}
            {% if block.settings.icon_color != blank or block.settings.icon_bg != blank %}
              style="{% if block.settings.icon_color != blank %}--sp-values-card-icon-color: {{ block.settings.icon_color }};{% endif %} {% if block.settings.icon_bg != blank %}--sp-values-card-icon-bg: {{ block.settings.icon_bg }};{% endif %}"
            {% endif %}
          >
            {% capture value_card_content %}
              {% if block.settings.show_icon %}
                <div class="sp-value-card__icon" aria-hidden="true">
                  {% render 'sp-content-icon', name: block.settings.icon %}
                </div>
              {% endif %}
              {% if block.settings.heading != blank %}
                <h3 class="sp-content-card__title sp-value-card__title">{{ block.settings.heading | escape }}</h3>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="sp-content-card__text sp-value-card__text">{{ block.settings.text | escape | newline_to_br }}</p>
              {% endif %}
            {% endcapture %}
            {% if block.settings.link != blank %}
              <a class="sp-value-card__inner sp-value-card__inner--link" href="{{ block.settings.link }}" aria-label="{{ block.settings.heading | default: 'View value' | escape }}">
                {{ value_card_content }}
              </a>
            {% else %}
              <div class="sp-value-card__inner">{{ value_card_content }}</div>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Values grid",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "custom.system"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Global design system"
    },
    {
      "type": "color_scheme",
      "id": "sp_color_scheme",
      "label": "Color scheme",
      "default": "scheme-1",
      "info": "Uses the shared Spider color panel from Theme settings."
    },
    {
      "type": "header",
      "content": "Section content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR VALUES"
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "Show eyebrow",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Thoughtful Choices for a Better Everyday"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>We believe in products that are well made, beautifully designed, and created to make everyday living more enjoyable.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Fallback accessible label",
      "default": "Our values"
    },
    {
      "type": "header",
      "content": "Layout & alignment"
    },
    {
      "type": "select",
      "id": "container_width",
      "label": "Container width",
      "default": "wide",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "wide",
          "label": "Theme wide"
        },
        {
          "value": "narrow",
          "label": "Theme narrow"
        }
      ]
    },
    {
      "type": "select",
      "id": "header_align",
      "label": "Header alignment",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ]
    },
    {
      "type": "range",
      "id": "header_max_width",
      "label": "Header max width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "default": 1240,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "description_max_width",
      "label": "Description max width",
      "min": 400,
      "max": 1000,
      "step": 20,
      "default": 780,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "default": "3",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns_tablet",
      "label": "Tablet columns",
      "default": "2",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        }
      ]
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "default": "1",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Card gap (0 = global)",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "header_gap",
      "label": "Header to cards gap",
      "min": 16,
      "max": 96,
      "step": 2,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 16,
      "max": 64,
      "step": 2,
      "default": 38,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_min_height",
      "label": "Card min height",
      "min": 220,
      "max": 500,
      "step": 10,
      "default": 380,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius (0 = global)",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "card_border",
      "label": "Show card border",
      "default": true
    },
    {
      "type": "select",
      "id": "card_shadow",
      "label": "Card shadow",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "soft",
          "label": "Soft"
        },
        {
          "value": "hover",
          "label": "On hover"
        }
      ]
    },
    {
      "type": "select",
      "id": "card_hover",
      "label": "Card hover",
      "default": "lift",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "lift",
          "label": "Subtle lift"
        },
        {
          "value": "border",
          "label": "Accent border"
        }
      ]
    },
    {
      "type": "select",
      "id": "card_alignment",
      "label": "Card content alignment",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ]
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "range",
      "id": "icon_circle_size",
      "label": "Icon circle size",
      "min": 60,
      "max": 150,
      "step": 2,
      "default": 112,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 26,
      "max": 76,
      "step": 2,
      "default": 50,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "icon_shape",
      "label": "Icon background shape",
      "default": "circle",
      "options": [
        {
          "value": "circle",
          "label": "Circle"
        },
        {
          "value": "rounded",
          "label": "Rounded square"
        }
      ]
    },
    {
      "type": "color",
      "id": "icon_color_override",
      "label": "Optional icon color override",
      "info": "Leave blank to inherit the Spider scheme accent."
    },
    {
      "type": "color",
      "id": "icon_bg_override",
      "label": "Optional icon background",
      "info": "Leave blank to use a soft tint of the scheme accent."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading desktop (0 = global)",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading mobile (0 = global)",
      "min": 0,
      "max": 52,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "eyebrow_size",
      "label": "Eyebrow (0 = global)",
      "min": 0,
      "max": 22,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Description (0 = global)",
      "min": 0,
      "max": 28,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Card title (0 = global)",
      "min": 0,
      "max": 44,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_text_size",
      "label": "Card text (0 = global)",
      "min": 0,
      "max": 26,
      "step": 1,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top (0 = global)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom (0 = global)",
      "min": 0,
      "max": 160,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Mobile top (0 = global)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Mobile bottom (0 = global)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 0,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "diamond",
          "options": [
            {
              "value": "diamond",
              "label": "Quality / Diamond"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "users",
              "label": "People"
            },
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "truck",
              "label": "Truck"
            },
            {
              "value": "return",
              "label": "Returns"
            },
            {
              "value": "package-return",
              "label": "Package returns"
            }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quality"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "We focus on thoughtful details, useful design, and products made to serve everyday needs."
        },
        {
          "type": "checkbox",
          "id": "show_icon",
          "label": "Show icon",
          "default": true
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional card link"
        },
        {
          "type": "color",
          "id": "icon_color",
          "label": "Optional card icon color"
        },
        {
          "type": "color",
          "id": "icon_bg",
          "label": "Optional card icon background"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Values grid",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "icon": "diamond",
            "heading": "Quality",
            "text": "We focus on thoughtful details, useful design, and carefully considered product choices."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "leaf",
            "heading": "Simplicity",
            "text": "Great design should feel intuitive. We value clean aesthetics and practical function."
          }
        },
        {
          "type": "value",
          "settings": {
            "icon": "heart",
            "heading": "Customer First",
            "text": "We aim to make every step, from browsing to support, clear, helpful, and easy."
          }
        }
      ],
      "category": "04. Content"
    }
  ]
}
{% endschema %}

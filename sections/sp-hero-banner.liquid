{% render 'sp-section-color-scheme', section: section %}
{{ 'sp-hero-banner.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign hb_image = section.settings.background_image
  if hb_image == blank and section.settings.mobile_background_image != blank
    assign hb_image = section.settings.mobile_background_image
  endif

  assign hb_mobile_image = section.settings.mobile_background_image
  assign hb_image_alt = section.settings.image_alt
  if hb_image_alt == blank and hb_image != blank
    assign hb_image_alt = hb_image.alt
  endif

  assign hb_heading_tag = section.settings.heading_tag | default: 'h1'
  assign hb_loading = 'lazy'
  if section.location == 'template' and section.index == 1
    assign hb_loading = 'eager'
  endif

  assign hb_overlay_alpha = section.settings.overlay_opacity | divided_by: 100.0
  assign hb_overlay_red = section.settings.overlay_color | color_extract: 'red'
  assign hb_overlay_green = section.settings.overlay_color | color_extract: 'green'
  assign hb_overlay_blue = section.settings.overlay_color | color_extract: 'blue'

  assign hb_primary_class = 'sp-hero-banner__button sp-hero-banner__button--primary'
  if section.settings.show_primary_arrow
    assign hb_primary_class = hb_primary_class | append: ' sp-hero-banner__button--arrow'
  endif

  assign hb_show_primary = false
  if section.settings.primary_button_label != blank and section.settings.primary_button_link != blank
    assign hb_show_primary = true
  endif

  assign hb_show_secondary = false
  if section.settings.secondary_button_label != blank and section.settings.secondary_button_link != blank
    assign hb_show_secondary = true
  endif
-%}

<section
  class="sp-hero-banner sp-hero-banner--content-{{ section.settings.content_position }} sp-hero-banner--vertical-{{ section.settings.vertical_position }} sp-hero-banner--text-{{ section.settings.text_alignment }} sp-hero-banner--mobile-content-{{ section.settings.mobile_content_position }} sp-hero-banner--mobile-vertical-{{ section.settings.mobile_vertical_position }} sp-hero-banner--mobile-text-{{ section.settings.mobile_text_alignment }} sp-hero-banner--overlay-{{ section.settings.overlay_style }}{% if section.settings.stack_buttons_mobile %} sp-hero-banner--stack-buttons-mobile{% endif %}{% if section.settings.enable_custom_text_colors %} sp-hero-banner--custom-text-colors{% endif %}"
  data-section-id="{{ section.id }}"
  style="
    --sp-hb-height-desktop: {{ section.settings.desktop_height }}px;
    --sp-hb-height-mobile: {{ section.settings.mobile_height }}px;
    --sp-hb-content-max: {{ section.settings.content_max_width }}px;
    --sp-hb-copy-max: {{ section.settings.copy_max_width }}px;
    --sp-hb-heading-size-d: {{ section.settings.heading_size_desktop }}px;
    --sp-hb-heading-size-m: {{ section.settings.heading_size_mobile }}px;
    --sp-hb-body-size: {{ section.settings.body_size }}px;
    --sp-hb-padding-y-d: {{ section.settings.content_padding_desktop }}px;
    --sp-hb-padding-y-m: {{ section.settings.content_padding_mobile }}px;
    --sp-hb-button-gap: {{ section.settings.button_gap }}px;
    --sp-hb-overlay-rgb: {{ hb_overlay_red }}, {{ hb_overlay_green }}, {{ hb_overlay_blue }};
    --sp-hb-overlay-opacity: {{ hb_overlay_alpha }};
    --sp-hb-image-position-d: {{ section.settings.image_position }};
    --sp-hb-image-position-m: {{ section.settings.mobile_image_position }};
    --sp-hb-image-fit: {{ section.settings.image_fit }};
    --sp-hb-radius: {{ section.settings.corner_radius }}px;
    --sp-hb-heading-color: {% if section.settings.enable_custom_text_colors %}{{ section.settings.heading_color }}{% else %}var(--sp-color-heading, #171717){% endif %};
    --sp-hb-text-color: {% if section.settings.enable_custom_text_colors %}{{ section.settings.body_color }}{% else %}var(--sp-color-text, #3F3F46){% endif %};
  "
  {% if section.settings.heading != blank %}
    aria-labelledby="SpHeroBannerTitle-{{ section.id }}"
  {% else %}
    aria-label="{{ section.settings.eyebrow | default: 'Hero banner' | escape }}"
  {% endif %}
>
  <div class="sp-hero-banner__media" aria-hidden="false">
    {% if hb_image != blank %}
      <picture class="sp-hero-banner__picture">
        {% if hb_mobile_image != blank %}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ hb_mobile_image | image_url: width: 360 }} 360w,
              {{ hb_mobile_image | image_url: width: 540 }} 540w,
              {{ hb_mobile_image | image_url: width: 750 }} 750w,
              {{ hb_mobile_image | image_url: width: 990 }} 990w,
              {{ hb_mobile_image | image_url: width: 1200 }} 1200w
            "
            sizes="100vw"
          >
        {% endif %}
        {% render 'responsive-image',
          image: hb_image,
          widths: '750, 990, 1200, 1500, 1800, 2000, 2400',
          sizes: '100vw',
          loading: hb_loading,
          class: 'sp-hero-banner__image',
          alt: hb_image_alt
        %}
      </picture>
    {% else %}
      {% render 'placeholder-image', name: 'lifestyle-2', class: 'sp-hero-banner__placeholder' %}
    {% endif %}
  </div>

  {% unless section.settings.overlay_style == 'none' %}
    <div class="sp-hero-banner__overlay" aria-hidden="true"></div>
  {% endunless %}

  <div class="sp-hero-banner__inner">
    <div class="sp-hero-banner__content">
      {% if section.settings.eyebrow != blank %}
        <p class="sp-hero-banner__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <{{ hb_heading_tag }} id="SpHeroBannerTitle-{{ section.id }}" class="sp-hero-banner__heading">
          {{ section.settings.heading | escape }}
        </{{ hb_heading_tag }}>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="sp-hero-banner__description rte">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if hb_show_primary or hb_show_secondary %}
        <div class="sp-hero-banner__actions">
          {% if hb_show_primary %}
            {% assign hb_primary_label = section.settings.primary_button_label | escape %}
            {% render 'button',
              label: hb_primary_label,
              href: section.settings.primary_button_link,
              style: section.settings.primary_button_style,
              class: hb_primary_class
            %}
          {% endif %}

          {% if hb_show_secondary %}
            {% assign hb_secondary_label = section.settings.secondary_button_label | escape %}
            {% render 'button',
              label: hb_secondary_label,
              href: section.settings.secondary_button_link,
              style: section.settings.secondary_button_style,
              class: 'sp-hero-banner__button sp-hero-banner__button--secondary'
            %}
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>


{{ 'sp-customer-account.css' | asset_url | stylesheet_tag }}
{% render 'sp-section-color-scheme', section: section %}
<section class="sp-section sp-account-page" style="--sp-account-pad-top:{{ section.settings.padding_top }}px;--sp-account-pad-bottom:{{ section.settings.padding_bottom }}px">
  <div class="sp-container{% if section.settings.container_width == 'wide' %} sp-container--wide{% elsif section.settings.container_width == 'narrow' %} sp-container--narrow{% endif %}">
    <header class="sp-account-page-header sp-account-page-header--order"><div><a class="sp-account-text-link" href="{{ routes.account_url }}#orders">← {{ 'customer.account.return' | t }}</a><h1>{{ 'customer.order.title' | t: name: order.name }}</h1><p>{{ order.created_at | time_tag: format: 'date' }}</p></div><div class="sp-account-order-statuses">{% if order.cancelled %}{% render 'sp-account-status-badge', status: 'cancelled', label: order.cancel_reason_label, kind: 'order' %}{% endif %}{% render 'sp-account-status-badge', status: order.financial_status, label: order.financial_status_label, kind: 'financial' %}{% render 'sp-account-status-badge', status: order.fulfillment_status, label: order.fulfillment_status_label, kind: 'fulfillment' %}</div></header>
    <div class="sp-account-shell"><aside>{% render 'sp-account-nav', active: 'orders' %}</aside><div class="sp-account-shell__main">
      <section class="sp-account-card" aria-labelledby="order-products"><div class="sp-account-card__heading"><h2 id="order-products">{{ 'customer.spider.order_items' | t }}</h2><span>{{ order.item_count }} {{ 'customer.spider.items' | t }}</span></div><div class="sp-account-order-lines">
        {% for line_item in order.line_items %}
          <article class="sp-account-order-line">
            <div class="sp-account-order-line__media">{% if line_item.image %}<a href="{{ line_item.url }}">{{ line_item.image | image_url: width: 180 | image_tag: widths: '90,120,180', sizes: '90px', loading: 'lazy', alt: line_item.image.alt | default: line_item.title }}</a>{% else %}<span class="sp-account-order-line__placeholder">{% render 'sp-account-icon', name: 'package' %}</span>{% endif %}</div>
            <div class="sp-account-order-line__info"><a href="{{ line_item.url }}"><strong>{{ line_item.title | escape }}</strong></a>{% if line_item.variant.title != blank and line_item.variant.title != 'Default Title' %}<p class="sp-account-meta">{{ line_item.variant.title | escape }}</p>{% endif %}{% if line_item.sku != blank %}<p class="sp-account-meta">{{ 'customer.order.sku' | t }}: {{ line_item.sku | escape }}</p>{% endif %}{% for property in line_item.properties %}{% assign first_char = property.first | slice: 0 %}{% if property.last != blank and first_char != '_' %}<p class="sp-account-meta"><strong>{{ property.first | escape }}:</strong> {{ property.last | escape }}</p>{% endif %}{% endfor %}</div>
            <div class="sp-account-order-line__qty"><span>{{ 'customer.order.quantity' | t }}</span><strong>{{ line_item.quantity }}</strong></div>
            <div class="sp-account-order-line__price"><span>{{ 'customer.order.price' | t }}</span><strong>{{ line_item.final_price | money }}</strong></div>
            <div class="sp-account-order-line__total"><span>{{ 'customer.order.total' | t }}</span><strong>{{ line_item.final_line_price | money }}</strong></div>
          </article>
        {% endfor %}
      </div></section>
      <div class="sp-account-order-detail-grid">
        <section class="sp-account-card sp-account-order-summary" aria-labelledby="order-summary"><h2 id="order-summary">{{ 'customer.spider.order_summary' | t }}</h2><dl><div><dt>{{ 'customer.order.subtotal' | t }}</dt><dd>{{ order.subtotal_price | money }}</dd></div>{% if order.total_discounts > 0 %}<div><dt>{{ 'customer.spider.discount' | t }}</dt><dd>−{{ order.total_discounts | money }}</dd></div>{% endif %}<div><dt>{{ 'customer.spider.shipping' | t }}</dt><dd>{{ order.shipping_price | money }}</dd></div><div><dt>{{ 'customer.spider.tax' | t }}</dt><dd>{{ order.tax_price | money }}</dd></div>{% if order.total_refunded_amount > 0 %}<div><dt>{{ 'customer.spider.refund' | t }}</dt><dd>−{{ order.total_refunded_amount | money }}</dd></div>{% endif %}<div class="is-total"><dt>{{ 'customer.order.total' | t }}</dt><dd>{{ order.total_net_amount | money }}</dd></div></dl></section>
        <section class="sp-account-card"><h2>{{ 'customer.spider.shipping_address' | t }}</h2>{% if order.shipping_address %}<div class="rte">{{ order.shipping_address | format_address }}</div>{% else %}<p class="sp-account-meta">{{ 'customer.spider.not_available' | t }}</p>{% endif %}</section>
        <section class="sp-account-card"><h2>{{ 'customer.spider.billing_address' | t }}</h2>{% if order.billing_address %}<div class="rte">{{ order.billing_address | format_address }}</div>{% else %}<p class="sp-account-meta">{{ 'customer.spider.not_available' | t }}</p>{% endif %}</section>
        {% if order.fulfillments.size > 0 %}<section class="sp-account-card sp-account-fulfillment"><h2>{{ 'customer.spider.fulfillment' | t }}</h2>{% for fulfillment in order.fulfillments %}<div class="sp-account-fulfillment__item"><p><strong>{% if fulfillment.tracking_company != blank %}{{ fulfillment.tracking_company | escape }}{% else %}{{ 'customer.spider.shipment' | t }}{% endif %}</strong></p>{% if fulfillment.tracking_number %}<p class="sp-account-meta">{{ 'customer.spider.tracking_number' | t }}: {{ fulfillment.tracking_number | escape }}</p>{% endif %}{% if fulfillment.tracking_url %}<a class="sp-button sp-button--outline" href="{{ fulfillment.tracking_url }}" target="_blank" rel="noopener">{{ 'customer.spider.track_package' | t }}</a>{% endif %}</div>{% endfor %}</section>{% endif %}
      </div>
    </div></div>
  </div>
</section>
{% schema %}
{"name":"Main order","settings":[{"type":"color_scheme","id":"sp_color_scheme","label":"Color scheme","default":"scheme-1"},{"type":"select","id":"container_width","label":"Container width","default":"default","options":[{"value":"narrow","label":"Narrow"},{"value":"default","label":"Theme default"},{"value":"wide","label":"Wide"}]},{"type":"range","id":"padding_top","label":"Padding top","min":24,"max":160,"step":8,"unit":"px","default":64},{"type":"range","id":"padding_bottom","label":"Padding bottom","min":24,"max":160,"step":8,"unit":"px","default":80}]}
{% endschema %}

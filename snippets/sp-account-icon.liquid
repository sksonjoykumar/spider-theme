{% comment %}Spider Customer Account scoped icon set. Parameters: name, class.{% endcomment %}
{% assign icon_class = class | default: 'sp-account-icon' %}
<svg class="{{ icon_class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
  {% case name %}
    {% when 'overview' %}<path d="M4 13h6V4H4v9Zm10 7h6V11h-6v9ZM4 20h6v-3H4v3Zm10-13h6V4h-6v3Z"/>
    {% when 'orders' %}<path d="M6 3h12l2 4v13H4V7l2-4Z"/><path d="M4 8h16M9 12h6"/>
    {% when 'addresses' %}<path d="M12 21s7-5.2 7-12a7 7 0 1 0-14 0c0 6.8 7 12 7 12Z"/><circle cx="12" cy="9" r="2.2"/>
    {% when 'logout' %}<path d="M10 4H5v16h5M14 8l4 4-4 4M18 12H9"/>
    {% when 'eye' %}<path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.4"/>
    {% when 'eye-off' %}<path d="m3 3 18 18M10.6 6.2c.5-.1.9-.2 1.4-.2 6 0 9.5 6 9.5 6a16 16 0 0 1-2.6 3.3M6.2 6.2C3.8 7.9 2.5 12 2.5 12s3.5 6 9.5 6c1.3 0 2.5-.3 3.5-.7M9.9 9.9a3 3 0 0 0 4.2 4.2"/>
    {% when 'edit' %}<path d="M4 20h4l11-11-4-4L4 16v4Z"/><path d="m13.5 6.5 4 4"/>
    {% when 'trash' %}<path d="M4 7h16M9 7V4h6v3M7 7l1 13h8l1-13M10 11v5M14 11v5"/>
    {% when 'plus' %}<path d="M12 5v14M5 12h14"/>
    {% when 'package' %}<path d="m4 7 8-4 8 4-8 4-8-4Z"/><path d="M4 7v10l8 4 8-4V7M12 11v10"/>
    {% when 'home' %}<path d="m3 11 9-8 9 8M5 10v10h14V10M9 20v-6h6v6"/>
    {% when 'user' %}<circle cx="12" cy="8" r="3.5"/><path d="M5 21c.8-4.5 3.1-6.5 7-6.5s6.2 2 7 6.5"/>
    {% when 'arrow-right' %}<path d="M5 12h14M14 7l5 5-5 5"/>
    {% when 'lock' %}<rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>
    {% when 'mail' %}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>
    {% when 'check' %}<path d="m5 12 4 4 10-10"/>
    {% else %}<circle cx="12" cy="12" r="9"/>
  {% endcase %}
</svg>

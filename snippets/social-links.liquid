<ul class="sp-social-links" role="list">{% assign networks = 'instagram,facebook,tiktok,youtube,pinterest,twitter,linkedin' | split: ',' %}{% for network in networks %}{% assign key = 'social_' | append: network %}{% assign url = settings[key] %}{% if url != blank %}<li><a class="sp-social-link" href="{{ url }}" aria-label="{{ network | capitalize }}"{% if settings.social_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}><span aria-hidden="true">{{ network | slice: 0 | upcase }}</span><span class="visually-hidden">{{ network | capitalize }}</span></a></li>{% endif %}{% endfor %}</ul>
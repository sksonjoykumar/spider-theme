{% comment %}LiquidDoc: Renders a small inline SVG icon. Parameters: name (required), class (optional).{% endcomment %}
{% assign icon_class = class | default: 'sp-icon' %}
<svg class="{{ icon_class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24">
  {% case name %}
    {% when 'menu' %}<path d="M3 6h18M3 12h18M3 18h18" fill="none" stroke="currentColor" stroke-width="2"/>
    {% when 'close' %}<path d="m5 5 14 14M19 5 5 19" fill="none" stroke="currentColor" stroke-width="2"/>
    {% when 'search' %}<circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m16 16 5 5" fill="none" stroke="currentColor" stroke-width="2"/>
    {% when 'cart' %}<path d="M4 5h2l2 10h9l2-7H7" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="10" cy="19" r="1.5"/><circle cx="17" cy="19" r="1.5"/>
    {% when 'account' %}<circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="2"/><path d="M4 21c1-5 4-7 8-7s7 2 8 7" fill="none" stroke="currentColor" stroke-width="2"/>
    {% when 'chevron' %}<path d="m8 10 4 4 4-4" fill="none" stroke="currentColor" stroke-width="2"/>
    {% when 'chevron-left' %}<path d="m15 5-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2"/>
    {% when 'chevron-right' %}<path d="m9 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2"/>
    {% when 'minus' %}<path d="M5 12h14" fill="none" stroke="currentColor" stroke-width="2"/>
    {% when 'plus' %}<path d="M5 12h14M12 5v14" fill="none" stroke="currentColor" stroke-width="2"/>
    {% when 'heart' %}<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z" fill="none" stroke="currentColor" stroke-width="1.8"/>
    {% when 'compare' %}<path d="M7 3v18M17 3v18M3 7l4-4 4 4M13 17l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    {% when 'share' %}<circle cx="18" cy="5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="6" cy="12" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="18" cy="19" r="2.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m8.2 10.8 7.6-4.5M8.2 13.2l7.6 4.5" fill="none" stroke="currentColor" stroke-width="1.8"/>
    {% when 'shield' %}<path d="M12 3 20 6v5c0 5-3.4 8.6-8 10-4.6-1.4-8-5-8-10V6l8-3Z" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="m8.5 12 2.2 2.2 4.8-5" fill="none" stroke="currentColor" stroke-width="1.8"/>
    {% when 'truck' %}<path d="M3 6h11v10H3zM14 10h4l3 3v3h-7z" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>
    {% when 'return' %}<path d="M8 7H4v-4M4.5 7A8 8 0 1 1 5 17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    {% when 'snowflake' %}<path d="M12 2v20M4 7l16 10M4 17 20 7M8 4l4 3 4-3M8 20l4-3 4 3M3 10l1-3 4 0M16 17l4 0 1-3M3 14l1 3 4 0M16 7l4 0 1 3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
    {% when 'droplet' %}<path d="M12 3C10 6.4 6 10.1 6 14a6 6 0 0 0 12 0c0-3.9-4-7.6-6-11Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
    {% when 'leaf' %}<path d="M20 4C10 4 5 7 5 13a6 6 0 0 0 6 6c6 0 9-7 9-15Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M4 21c3-6 7-9 12-12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    {% when 'star' %}<path d="m12 3 2.7 5.5 6.1.9-4.4 4.3 1 6.1-5.4-2.9-5.4 2.9 1-6.1-4.4-4.3 6.1-.9L12 3Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
    {% else %}<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/>
  {% endcase %}
</svg>

{% liquid
  assign has_button_1 = false
  assign has_button_2 = false
  if section.settings.button_1_label != blank
    assign has_button_1 = true
  endif
  if section.settings.button_2_label != blank
    assign has_button_2 = true
  endif
  assign button_2_video = false
  if section.settings.button_2_action == 'play_video'
    assign button_2_video = true
  endif
%}
{% if has_button_1 or has_button_2 %}
  <div class="sp-hero-video__buttons{% if section.settings.stack_buttons_mobile %} sp-hero-video__buttons--stack-mobile{% endif %}{% if section.settings.full_width_buttons_mobile %} sp-hero-video__buttons--full-mobile{% endif %}">
    {% if has_button_1 %}
      {% if section.settings.button_1_url != blank %}
        <a
          class="sp-button sp-hero-video__button sp-hero-video__button--1 sp-hero-video__button--{{ section.settings.button_1_style }} sp-hero-video__button--{{ section.settings.button_1_size }}"
          href="{{ section.settings.button_1_url }}"
          {% if section.settings.button_1_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
        ><span>{{ section.settings.button_1_label | escape }}</span>{% if section.settings.button_show_arrows %}<svg class="sp-hero-video__button-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>{% endif %}</a>
      {% else %}
        <span class="sp-button sp-hero-video__button sp-hero-video__button--1 sp-hero-video__button--{{ section.settings.button_1_style }} sp-hero-video__button--{{ section.settings.button_1_size }} is-disabled" aria-disabled="true">{{ section.settings.button_1_label | escape }}</span>
      {% endif %}
    {% endif %}

    {% if has_button_2 %}
      {% if button_2_video %}
        <button type="button" data-sp-hv-watch class="sp-button sp-hero-video__button sp-hero-video__button--2 sp-hero-video__button--{{ section.settings.button_2_style }} sp-hero-video__button--{{ section.settings.button_2_size }}">
          <span>{{ section.settings.button_2_label | escape }}</span>{% if section.settings.button_show_arrows %}<svg class="sp-hero-video__button-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>{% endif %}
        </button>
      {% elsif section.settings.button_2_url != blank %}
        <a
          class="sp-button sp-hero-video__button sp-hero-video__button--2 sp-hero-video__button--{{ section.settings.button_2_style }} sp-hero-video__button--{{ section.settings.button_2_size }}"
          href="{{ section.settings.button_2_url }}"
          {% if section.settings.button_2_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
        ><span>{{ section.settings.button_2_label | escape }}</span>{% if section.settings.button_show_arrows %}<svg class="sp-hero-video__button-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>{% endif %}</a>
      {% else %}
        <span class="sp-button sp-hero-video__button sp-hero-video__button--2 sp-hero-video__button--{{ section.settings.button_2_style }} sp-hero-video__button--{{ section.settings.button_2_size }} is-disabled" aria-disabled="true">{{ section.settings.button_2_label | escape }}</span>
      {% endif %}
    {% endif %}
  </div>
{% endif %}

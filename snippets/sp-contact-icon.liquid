{% comment %}
  Spider Contact icon set.
  Parameters:
  - name: icon name
  - class: optional class name
{% endcomment %}
{%- assign icon_class = class | default: 'sp-contact-icon' -%}
<svg class="{{ icon_class }}" aria-hidden="true" focusable="false" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
  {%- case name -%}
    {%- when 'email' -%}
      <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/>
      <path d="m4.5 7 7.5 6 7.5-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/>
      <path d="M12 7v5l3.5 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'share' -%}
      <circle cx="18" cy="5" r="2.5" stroke="currentColor" stroke-width="1.8"/>
      <circle cx="6" cy="12" r="2.5" stroke="currentColor" stroke-width="1.8"/>
      <circle cx="18" cy="19" r="2.5" stroke="currentColor" stroke-width="1.8"/>
      <path d="m8.2 10.8 7.6-4.5M8.2 13.2l7.6 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    {%- when 'truck' -%}
      <path d="M3 6h11v10H3V6Zm11 4h4l3 3v3h-7v-6Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
      <circle cx="7" cy="18" r="2" stroke="currentColor" stroke-width="1.8"/>
      <circle cx="17" cy="18" r="2" stroke="currentColor" stroke-width="1.8"/>
    {%- when 'box' -%}
      <path d="m4 8 8-4 8 4-8 4-8-4Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
      <path d="M4 8v8l8 4 8-4V8M12 12v8" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
    {%- when 'chat' -%}
      <path d="M20 11.5a7.5 7.5 0 0 1-8 7.5 8.7 8.7 0 0 1-3.2-.6L4 20l1.6-4.2A7 7 0 0 1 4 11.5 7.5 7.5 0 0 1 12 4a7.5 7.5 0 0 1 8 7.5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M8 11.5h.01M12 11.5h.01M16 11.5h.01" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/>
    {%- when 'question' -%}
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/>
      <path d="M9.7 9a2.45 2.45 0 1 1 3.4 2.25c-.7.3-1.1.85-1.1 1.55v.2M12 17h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    {%- when 'headset' -%}
      <path d="M4 13v-1a8 8 0 0 1 16 0v1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
      <path d="M4 13a2 2 0 0 1 2-2h1v6H6a2 2 0 0 1-2-2v-2ZM20 13a2 2 0 0 0-2-2h-1v6h1a2 2 0 0 0 2-2v-2ZM17 18c-.8 1.3-2.1 2-4 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'pin' -%}
      <path d="M12 21s6-5.1 6-11a6 6 0 1 0-12 0c0 5.9 6 11 6 11Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
      <circle cx="12" cy="10" r="2" stroke="currentColor" stroke-width="1.8"/>
    {%- when 'phone' -%}
      <path d="M8.2 3.5 10 7.7 7.8 9.4c1.2 2.7 3.1 4.6 5.8 5.8l1.7-2.2 4.2 1.8-.7 4a2 2 0 0 1-2 1.7C9.5 20.5 3.5 14.5 3.5 7.2a2 2 0 0 1 1.7-2l3-.7Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/>
      <path d="M3.5 12h17M12 3c2.2 2.4 3.3 5.4 3.3 9S14.2 18.6 12 21M12 3C9.8 5.4 8.7 8.4 8.7 12s1.1 6.6 3.3 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    {%- when 'instagram' -%}
      <rect x="4" y="4" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.8"/>
      <circle cx="12" cy="12" r="3.5" stroke="currentColor" stroke-width="1.8"/>
      <circle cx="17.2" cy="6.8" r="1" fill="currentColor"/>
    {%- when 'facebook' -%}
      <path d="M13.5 21v-8h2.8l.4-3h-3.2V8.1c0-.9.3-1.6 1.7-1.6H17V3.8c-.3 0-1.4-.1-2.6-.1-2.6 0-4.4 1.6-4.4 4.6V10H7v3h3v8h3.5Z" fill="currentColor"/>
    {%- when 'youtube' -%}
      <path d="M21 8.2a2.8 2.8 0 0 0-2-2C17.3 5.7 12 5.7 12 5.7s-5.3 0-7 .5a2.8 2.8 0 0 0-2 2A29 29 0 0 0 2.5 12 29 29 0 0 0 3 15.8a2.8 2.8 0 0 0 2 2c1.7.5 7 .5 7 .5s5.3 0 7-.5a2.8 2.8 0 0 0 2-2 29 29 0 0 0 .5-3.8 29 29 0 0 0-.5-3.8Z" stroke="currentColor" stroke-width="1.6"/>
      <path d="m10 9 5 3-5 3V9Z" fill="currentColor"/>
    {%- when 'pinterest' -%}
      <path d="M12 3a9 9 0 0 0-3.3 17.4c-.1-1.5 0-3.2.4-4.6l1.1-4.5s-.3-.7-.3-1.8c0-1.7 1-3 2.2-3 1 0 1.5.8 1.5 1.7 0 1-.7 2.6-1 4-.3 1.2.6 2.2 1.8 2.2 2.2 0 3.8-2.3 3.8-5.6 0-2.9-2.1-5-5.1-5-3.5 0-5.5 2.6-5.5 5.3 0 1 .4 2.2 1 2.8.1.1.1.2.1.4l-.4 1.6c-.1.5-.5.6-.9.4-1.8-.8-2.9-3.3-2.9-5.4C4.5 4.9 7.6 2 12.8 2 17.2 2 20.5 5.1 20.5 9.3c0 4.3-2.7 7.8-6.5 7.8-1.3 0-2.5-.7-2.9-1.5l-.8 3c-.3 1.1-1 2.5-1.5 3.4.9.3 2 .5 3.2.5a9 9 0 0 0 0-18Z" fill="currentColor"/>
    {%- when 'linkedin' -%}
      <path d="M6.4 8.4H3.5V21h2.9V8.4ZM5 3a1.8 1.8 0 1 0 0 3.6A1.8 1.8 0 0 0 5 3ZM21 13.8c0-3.8-2-5.6-4.7-5.6-2.2 0-3.1 1.2-3.7 2V8.4H9.7V21h2.9v-6.2c0-1.6.3-3.2 2.3-3.2 2 0 2 1.8 2 3.3V21H20l1-7.2Z" fill="currentColor"/>
    {%- when 'tiktok' -%}
      <path d="M15.4 3c.3 2.1 1.5 3.4 3.6 3.6v3a8.4 8.4 0 0 1-3.6-1.1v6.2a6.2 6.2 0 1 1-5.4-6.1v3.1a3.2 3.2 0 1 0 2.4 3.1V3h3Z" fill="currentColor"/>
    {%- when 'twitter' -%}
      <path d="M18.9 3h3.4l-7.4 8.5L23.5 21h-6.8l-5.3-6.3L5.9 21H2.5l7.3-8.4L1.5 3h7l4.8 5.7L18.9 3Zm-1.2 16h1.9L7.4 4.9h-2L17.7 19Z" fill="currentColor"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/>
  {%- endcase -%}
</svg>
